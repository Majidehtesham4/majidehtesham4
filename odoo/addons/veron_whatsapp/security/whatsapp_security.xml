<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="group_whatsapp_user" model="res.groups">
		<field name="name">WhatsApp</field>
		<field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
		<field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
	</record>
	<record id="rule_message_company" model="ir.rule">
		<field name="name">WhatsApp messages: the user's companies</field>
		<field name="model_id" ref="model_veron_whatsapp_message"/>
		<field name="global" eval="True"/>
		<field name="domain_force">[('company_id', 'in', company_ids)]</field>
	</record>
	<record id="rule_account_company" model="ir.rule">
		<field name="name">WhatsApp numbers: the user's companies</field>
		<field name="model_id" ref="model_veron_whatsapp_account"/>
		<field name="global" eval="True"/>
		<field name="domain_force">[('company_id', 'in', company_ids)]</field>
	</record>
</odoo>
