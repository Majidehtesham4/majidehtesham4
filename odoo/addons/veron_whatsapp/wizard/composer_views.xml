<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="composer_view_form" model="ir.ui.view">
		<field name="name">veron.whatsapp.composer.form</field>
		<field name="model">veron.whatsapp.composer</field>
		<field name="arch" type="xml">
			<form>
				<group>
					<field name="account_id" options="{'no_create': True}"/>
					<field name="phones" string="To"/>
					<field name="template_id" options="{'no_create': True}"/>
					<field name="text" invisible="template_id" placeholder="Free text, within 24 hours of the customer's last message"/>
					<field name="preview" invisible="not template_id"/>
					<field name="res_model" invisible="1"/>
					<field name="res_ids" invisible="1"/>
				</group>
				<footer>
					<button name="action_send" type="object" string="Send" class="btn-primary"/>
					<button special="cancel" string="Cancel"/>
				</footer>
			</form>
		</field>
	</record>
	<record id="action_composer_partner" model="ir.actions.act_window">
		<field name="name">Send WhatsApp</field>
		<field name="res_model">veron.whatsapp.composer</field>
		<field name="view_mode">form</field>
		<field name="target">new</field>
		<field name="binding_model_id" ref="base.model_res_partner"/>
		<field name="binding_view_types">form,list</field>
		<field name="group_ids" eval="[(4, ref('group_whatsapp_user'))]"/>
	</record>
</odoo>
