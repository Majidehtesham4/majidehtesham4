<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="group_rental_user" model="res.groups">
		<field name="name">Rental</field>
		<field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
		<field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
	</record>
	<record id="rule_rental_company" model="ir.rule">
		<field name="name">Rental orders: the user's companies</field>
		<field name="model_id" ref="model_veron_rental_order"/>
		<field name="global" eval="True"/>
		<field name="domain_force">[('company_id', 'in', company_ids)]</field>
	</record>
</odoo>
