<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="order_view_form" model="ir.ui.view">
		<field name="name">veron.rental.order.form</field>
		<field name="model">veron.rental.order</field>
		<field name="arch" type="xml">
			<form>
				<header>
					<button name="action_reserve" type="object" string="Reserve" class="btn-primary" invisible="state != 'draft'"/>
					<button name="action_pickup" type="object" string="Picked Up" class="btn-primary" invisible="state != 'reserved'"/>
					<button name="action_return" type="object" string="Returned" class="btn-primary" invisible="state != 'picked_up'"/>
					<button name="action_invoice" type="object" string="Create Invoice" class="btn-primary" invisible="state != 'returned'"/>
					<button name="action_cancel" type="object" string="Cancel" invisible="state not in ('draft', 'reserved')"/>
					<button name="action_draft" type="object" string="Back to Quotation" invisible="state != 'cancel'"/>
					<field name="state" widget="statusbar" statusbar_visible="draft,reserved,picked_up,returned,invoiced"/>
				</header>
				<sheet>
					<div class="oe_button_box" name="button_box">
						<button name="action_open_invoice" type="object" class="oe_stat_button" icon="fa-file-text-o" invisible="not invoice_id">
							<div class="o_stat_info"><span class="o_stat_text">Invoice</span></div>
						</button>
					</div>
					<widget name="web_ribbon" title="Late" bg_color="text-bg-danger" invisible="not is_late"/>
					<div class="oe_title"><h1><field name="name"/></h1></div>
					<group>
						<group>
							<field name="partner_id" readonly="state not in ('draft',)"/>
							<field name="user_id" widget="many2one_avatar_user"/>
							<field name="deposit" readonly="state in ('returned', 'invoiced', 'cancel')"/>
							<field name="invoice_id" invisible="1"/>
							<field name="is_late" invisible="1"/>
						</group>
						<group>
							<field name="start_date" readonly="state != 'draft'"/>
							<field name="end_date" readonly="state not in ('draft', 'reserved', 'picked_up')"/>
							<field name="days"/>
							<field name="returned_date" invisible="not returned_date"/>
							<field name="late_days" invisible="not late_days" decoration-danger="late_days"/>
						</group>
					</group>
					<field name="line_ids" readonly="state != 'draft'">
						<list editable="bottom">
							<field name="product_id" context="{'default_rent_ok': True}"/>
							<field name="quantity"/>
							<field name="price_day"/>
							<field name="subtotal" sum="Total"/>
							<field name="currency_id" column_invisible="True"/>
						</list>
					</field>
					<group class="oe_subtotal_footer">
						<field name="currency_id" invisible="1"/>
						<field name="amount_rent"/>
						<field name="amount_late" invisible="not amount_late"/>
						<field name="amount_total" class="oe_subtotal_footer_separator"/>
					</group>
					<field name="note" placeholder="Conditions of the rental..."/>
				</sheet>
				<chatter/>
			</form>
		</field>
	</record>

	<record id="order_view_list" model="ir.ui.view">
		<field name="name">veron.rental.order.list</field>
		<field name="model">veron.rental.order</field>
		<field name="arch" type="xml">
			<list decoration-danger="is_late">
				<field name="name"/>
				<field name="partner_id"/>
				<field name="start_date"/>
				<field name="end_date"/>
				<field name="days"/>
				<field name="amount_total" sum="Total"/>
				<field name="currency_id" column_invisible="True"/>
				<field name="is_late" column_invisible="True"/>
				<field name="state" widget="badge" decoration-info="state in ('reserved', 'picked_up')" decoration-success="state in ('returned', 'invoiced')"/>
			</list>
		</field>
	</record>

	<record id="order_view_calendar" model="ir.ui.view">
		<field name="name">veron.rental.order.calendar</field>
		<field name="model">veron.rental.order</field>
		<field name="arch" type="xml">
			<calendar date_start="start_date" date_stop="end_date" color="partner_id" mode="month" quick_create="false" event_open_popup="true">
				<field name="partner_id"/>
				<field name="state"/>
			</calendar>
		</field>
	</record>

	<record id="order_view_timeline" model="ir.ui.view">
		<field name="name">veron.rental.order.timeline</field>
		<field name="model">veron.rental.order</field>
		<field name="type">timeline</field>
		<field name="arch" type="xml">
			<timeline date_start="start_date" date_stop="end_date" default_group_by="partner_id" event_open_popup="true"
				colors="#ec7063: is_late == true; #95a5a6: state == 'draft'">
				<field name="state"/>
				<field name="is_late"/>
				<templates>
					<t t-name="timeline-item">
						<div><t t-esc="record.display_name"/></div>
					</t>
				</templates>
			</timeline>
		</field>
	</record>

	<record id="order_view_search" model="ir.ui.view">
		<field name="name">veron.rental.order.search</field>
		<field name="model">veron.rental.order</field>
		<field name="arch" type="xml">
			<search>
				<field name="name"/>
				<field name="partner_id"/>
				<field name="line_ids" string="Product" filter_domain="[('line_ids.product_id', 'ilike', self)]"/>
				<filter name="late" string="Not Returned on Time" domain="[('is_late', '=', True)]"/>
				<filter name="to_pickup" string="To Pick Up" domain="[('state', '=', 'reserved')]"/>
				<filter name="out" string="Out" domain="[('state', '=', 'picked_up')]"/>
				<filter name="to_invoice" string="To Invoice" domain="[('state', '=', 'returned')]"/>
				<separator/>
				<filter name="start" string="Pickup" date="start_date"/>
				<group>
					<filter name="by_customer" string="Customer" context="{'group_by': 'partner_id'}"/>
					<filter name="by_state" string="Status" context="{'group_by': 'state'}"/>
				</group>
			</search>
		</field>
	</record>

	<record id="product_view_form" model="ir.ui.view">
		<field name="name">product.template.form.veron.rental</field>
		<field name="model">product.template</field>
		<field name="inherit_id" ref="product.product_template_form_view"/>
		<field name="arch" type="xml">
			<xpath expr="//notebook" position="inside">
				<page string="Rental" name="veron_rental">
					<group>
						<group>
							<field name="rent_ok"/>
							<field name="rental_units" invisible="not rent_ok"/>
						</group>
						<group invisible="not rent_ok">
							<field name="rental_price_day"/>
							<field name="rental_late_fee_day"/>
						</group>
					</group>
				</page>
			</xpath>
		</field>
	</record>

	<record id="action_orders" model="ir.actions.act_window">
		<field name="name">Rental Orders</field>
		<field name="res_model">veron.rental.order</field>
		<field name="view_mode">list,form,calendar,timeline</field>
		<field name="help" type="html">
			<p class="o_view_nocontent_smiling_face">Rent out the first product</p>
			<p>Mark the products that can be rented (product form, Rental tab), with their price per day.</p>
		</field>
	</record>
	<record id="action_products" model="ir.actions.act_window">
		<field name="name">Products for Rent</field>
		<field name="res_model">product.template</field>
		<field name="view_mode">kanban,list,form</field>
		<field name="domain">[('rent_ok', '=', True)]</field>
		<field name="context">{'default_rent_ok': True, 'default_type': 'consu'}</field>
	</record>

	<menuitem id="menu_root" name="Rental" web_icon="veron_rental,static/description/icon.png" groups="group_rental_user" sequence="48"/>
	<menuitem id="menu_orders" name="Rental Orders" parent="menu_root" action="action_orders" sequence="1"/>
	<menuitem id="menu_products" name="Products for Rent" parent="menu_root" action="action_products" sequence="2"/>
</odoo>
