<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="rule_cheque_company" model="ir.rule">
		<field name="name">Cheques: the user's companies</field>
		<field name="model_id" ref="model_veron_cheque"/>
		<field name="global" eval="True"/>
		<field name="domain_force">[('company_id', 'in', company_ids)]</field>
	</record>
	<record id="rule_book_company" model="ir.rule">
		<field name="name">Cheque books: the user's companies</field>
		<field name="model_id" ref="model_veron_cheque_book"/>
		<field name="global" eval="True"/>
		<field name="domain_force">[('company_id', 'in', company_ids)]</field>
	</record>
</odoo>
