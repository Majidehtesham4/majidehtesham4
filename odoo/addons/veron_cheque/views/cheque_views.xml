<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="cheque_view_form" model="ir.ui.view">
		<field name="name">veron.cheque.form</field>
		<field name="model">veron.cheque</field>
		<field name="arch" type="xml">
			<form>
				<header>
					<button name="action_receive" type="object" string="Receive" class="btn-primary" invisible="direction != 'in' or state != 'draft'"/>
					<button name="action_deposit" type="object" string="Deposit to Bank" class="btn-primary" invisible="state != 'hand'"/>
					<button name="action_cash" type="object" string="Cashed" class="btn-success" invisible="state not in ('collection', 'issued')"/>
					<button name="action_cash" type="object" string="Cashed at the Counter" invisible="state != 'hand'"/>
					<button name="action_bounce" type="object" string="Bounced" class="btn-danger" invisible="state != 'collection'" confirm="Record that this cheque bounced?"/>
					<button name="action_endorse" type="object" string="Endorse" invisible="state != 'hand'"/>
					<button name="action_return" type="object" string="Return to Customer" invisible="state not in ('hand', 'bounced')"/>
					<button name="action_issue" type="object" string="Issue" class="btn-primary" invisible="direction != 'out' or state != 'draft'"/>
					<button name="action_cancel" type="object" string="Cancel Cheque" invisible="state != 'issued'" confirm="Cancel this cheque? It must have come back to you."/>
					<field name="state" widget="statusbar" statusbar_visible="draft,hand,collection,cashed" invisible="direction != 'in'"/>
					<field name="state" widget="statusbar" statusbar_visible="draft,issued,cashed" invisible="direction != 'out'"/>
				</header>
				<sheet>
					<div class="oe_button_box" name="button_box">
						<button name="action_open_moves" type="object" class="oe_stat_button" icon="fa-book" invisible="not move_count">
							<field name="move_count" widget="statinfo" string="Entries"/>
						</button>
					</div>
					<field name="direction" invisible="1"/>
					<div class="oe_title"><h1><field name="name"/></h1></div>
					<group>
						<group>
							<field name="partner_id" readonly="state != 'draft'" string="Customer" invisible="direction != 'in'"/>
							<field name="partner_id" readonly="state != 'draft'" string="Payee" invisible="direction != 'out'"/>
							<field name="amount" readonly="state != 'draft'"/>
							<field name="amount_words" class="text-muted"/>
							<field name="currency_id" invisible="1"/>
							<field name="due_date" readonly="state not in ('draft', 'hand', 'issued')"/>
							<field name="issue_date" readonly="state != 'draft'"/>
						</group>
						<group>
							<field name="book_id" invisible="direction != 'out'" readonly="state != 'draft'"/>
							<field name="sayad_id" readonly="state != 'draft'"/>
							<field name="serial" readonly="state != 'draft'"/>
							<field name="bank_id" invisible="direction != 'in'" readonly="state != 'draft'"/>
							<field name="branch" invisible="direction != 'in'" readonly="state != 'draft'"/>
							<field name="account_number" invisible="direction != 'in'" readonly="state != 'draft'"/>
							<field name="drawer" invisible="direction != 'in'" readonly="state != 'draft'"/>
							<field name="bank_journal_id" readonly="state in ('cashed', 'bounced', 'returned', 'endorsed', 'cancelled')"
								required="state == 'hand' and direction == 'in' or direction == 'out'"/>
							<field name="endorse_partner_id" invisible="direction != 'in' or state not in ('hand', 'endorsed')" readonly="state != 'hand'"/>
						</group>
					</group>
					<field name="note" placeholder="Notes..."/>
				</sheet>
				<chatter/>
			</form>
		</field>
	</record>

	<record id="cheque_view_list" model="ir.ui.view">
		<field name="name">veron.cheque.list</field>
		<field name="model">veron.cheque</field>
		<field name="arch" type="xml">
			<list decoration-danger="due_date &lt; current_date and state in ('hand', 'collection', 'issued')" decoration-muted="state in ('returned', 'cancelled')">
				<field name="due_date"/>
				<field name="partner_id"/>
				<field name="serial"/>
				<field name="sayad_id" optional="show"/>
				<field name="bank_id" optional="show"/>
				<field name="bank_journal_id" optional="hide"/>
				<field name="amount" sum="Total"/>
				<field name="currency_id" column_invisible="True"/>
				<field name="state" widget="badge" decoration-info="state in ('hand', 'issued')" decoration-warning="state == 'collection'"
					decoration-success="state == 'cashed'" decoration-danger="state == 'bounced'"/>
			</list>
		</field>
	</record>

	<record id="cheque_view_search" model="ir.ui.view">
		<field name="name">veron.cheque.search</field>
		<field name="model">veron.cheque</field>
		<field name="arch" type="xml">
			<search>
				<field name="partner_id"/>
				<field name="serial"/>
				<field name="sayad_id"/>
				<field name="bank_id"/>
				<filter name="open" string="Open" domain="[('state', 'in', ('hand', 'collection', 'issued'))]"/>
				<filter name="overdue" string="Past Due" domain="[('state', 'in', ('hand', 'collection', 'issued')), ('due_date', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
				<filter name="this_week" string="Due in 7 Days" domain="[('state', 'in', ('hand', 'collection', 'issued')), ('due_date', '&lt;=', (context_today() + relativedelta(days=7)).strftime('%Y-%m-%d'))]"/>
				<separator/>
				<filter name="hand" string="In Hand" domain="[('state', '=', 'hand')]"/>
				<filter name="collection" string="In Collection" domain="[('state', '=', 'collection')]"/>
				<filter name="bounced" string="Bounced" domain="[('state', '=', 'bounced')]"/>
				<separator/>
				<filter name="due" string="Due Date" date="due_date"/>
				<group>
					<filter name="by_due" string="Due Month" context="{'group_by': 'due_date:month'}"/>
					<filter name="by_partner" string="Partner" context="{'group_by': 'partner_id'}"/>
					<filter name="by_state" string="Status" context="{'group_by': 'state'}"/>
					<filter name="by_bank" string="Bank Account" context="{'group_by': 'bank_journal_id'}"/>
				</group>
			</search>
		</field>
	</record>

	<record id="cheque_view_pivot" model="ir.ui.view">
		<field name="name">veron.cheque.pivot</field>
		<field name="model">veron.cheque</field>
		<field name="arch" type="xml">
			<pivot>
				<field name="due_date" interval="month" type="row"/>
				<field name="state" type="col"/>
				<field name="amount" type="measure"/>
			</pivot>
		</field>
	</record>

	<record id="cheque_view_calendar" model="ir.ui.view">
		<field name="name">veron.cheque.calendar</field>
		<field name="model">veron.cheque</field>
		<field name="arch" type="xml">
			<calendar date_start="due_date" mode="month" color="direction" quick_create="false" event_open_popup="true">
				<field name="partner_id"/>
				<field name="amount"/>
				<field name="state"/>
			</calendar>
		</field>
	</record>

	<record id="book_view_list" model="ir.ui.view">
		<field name="name">veron.cheque.book.list</field>
		<field name="model">veron.cheque.book</field>
		<field name="arch" type="xml">
			<list>
				<field name="name"/>
				<field name="journal_id"/>
				<field name="first_serial"/>
				<field name="sheets"/>
				<field name="next_serial"/>
				<field name="remaining"/>
			</list>
		</field>
	</record>
	<record id="book_view_form" model="ir.ui.view">
		<field name="name">veron.cheque.book.form</field>
		<field name="model">veron.cheque.book</field>
		<field name="arch" type="xml">
			<form>
				<sheet>
					<group>
						<group>
							<field name="name" placeholder="e.g. Mellat book 2"/>
							<field name="journal_id"/>
						</group>
						<group>
							<field name="first_serial"/>
							<field name="sheets"/>
							<field name="next_serial"/>
							<field name="remaining"/>
						</group>
					</group>
				</sheet>
			</form>
		</field>
	</record>

	<record id="action_received" model="ir.actions.act_window">
		<field name="name">Received Cheques</field>
		<field name="res_model">veron.cheque</field>
		<field name="view_mode">list,form,calendar,pivot</field>
		<field name="domain">[('direction', '=', 'in')]</field>
		<field name="context">{'default_direction': 'in', 'search_default_open': 1}</field>
		<field name="help" type="html"><p class="o_view_nocontent_smiling_face">Record the first cheque received</p></field>
	</record>
	<record id="action_issued" model="ir.actions.act_window">
		<field name="name">Issued Cheques</field>
		<field name="res_model">veron.cheque</field>
		<field name="view_mode">list,form,calendar,pivot</field>
		<field name="domain">[('direction', '=', 'out')]</field>
		<field name="context">{'default_direction': 'out', 'search_default_open': 1}</field>
		<field name="help" type="html"><p class="o_view_nocontent_smiling_face">Record the first cheque issued</p><p>Add your cheque books first, under Cheque Books.</p></field>
	</record>
	<record id="action_books" model="ir.actions.act_window">
		<field name="name">Cheque Books</field>
		<field name="res_model">veron.cheque.book</field>
		<field name="view_mode">list,form</field>
	</record>

	<menuitem id="menu_cheques" name="Cheques" parent="account.menu_finance" sequence="4" groups="account.group_account_invoice,account.group_account_readonly"/>
	<menuitem id="menu_received" name="Received Cheques" parent="menu_cheques" action="action_received" sequence="1"/>
	<menuitem id="menu_issued" name="Issued Cheques" parent="menu_cheques" action="action_issued" sequence="2"/>
	<menuitem id="menu_books" name="Cheque Books" parent="menu_cheques" action="action_books" sequence="3"/>
</odoo>
