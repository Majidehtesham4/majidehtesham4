<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<!-- An employee sees their own appraisals, a manager their team's; HR all of them -->
	<record id="rule_appraisal_own" model="ir.rule">
		<field name="name">Appraisals: one's own and one's team's</field>
		<field name="model_id" ref="model_veron_appraisal"/>
		<field name="groups" eval="[(4, ref('base.group_user'))]"/>
		<field name="domain_force">['|', ('employee_user_id', '=', user.id), ('manager_user_id', '=', user.id)]</field>
	</record>
	<record id="rule_appraisal_hr" model="ir.rule">
		<field name="name">Appraisals: all, for HR</field>
		<field name="model_id" ref="model_veron_appraisal"/>
		<field name="groups" eval="[(4, ref('hr.group_hr_user'))]"/>
		<field name="domain_force">[(1, '=', 1)]</field>
	</record>
	<record id="rule_line_own" model="ir.rule">
		<field name="name">Appraisal answers: one's own and one's team's</field>
		<field name="model_id" ref="model_veron_appraisal_line"/>
		<field name="groups" eval="[(4, ref('base.group_user'))]"/>
		<field name="domain_force">['|', ('appraisal_id.employee_user_id', '=', user.id), ('appraisal_id.manager_user_id', '=', user.id)]</field>
	</record>
	<record id="rule_line_hr" model="ir.rule">
		<field name="name">Appraisal answers: all, for HR</field>
		<field name="model_id" ref="model_veron_appraisal_line"/>
		<field name="groups" eval="[(4, ref('hr.group_hr_user'))]"/>
		<field name="domain_force">[(1, '=', 1)]</field>
	</record>
	<record id="rule_appraisal_company" model="ir.rule">
		<field name="name">Appraisals: the user's companies</field>
		<field name="model_id" ref="model_veron_appraisal"/>
		<field name="global" eval="True"/>
		<field name="domain_force">[('company_id', 'in', company_ids)]</field>
	</record>
</odoo>
