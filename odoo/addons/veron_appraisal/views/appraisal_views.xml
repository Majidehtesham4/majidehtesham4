<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="appraisal_view_form" model="ir.ui.view">
		<field name="name">veron.appraisal.form</field>
		<field name="model">veron.appraisal</field>
		<field name="arch" type="xml">
			<form>
				<header>
					<button name="action_start" type="object" string="Start" class="btn-primary" invisible="state != 'new'" groups="hr.group_hr_user"/>
					<button name="action_done" type="object" string="Close Appraisal" class="btn-primary" invisible="state != 'pending' or not is_manager"/>
					<button name="action_cancel" type="object" string="Cancel" invisible="state in ('done', 'cancel')" groups="hr.group_hr_user"/>
					<button name="action_reset" type="object" string="Reset" invisible="state != 'cancel'" groups="hr.group_hr_user"/>
					<field name="state" widget="statusbar" statusbar_visible="new,pending,done"/>
				</header>
				<sheet>
					<div class="oe_button_box" name="button_box"/>
					<div class="oe_title">
						<h1><field name="employee_id" widget="many2one_avatar_employee" readonly="state != 'new'" placeholder="Employee"/></h1>
					</div>
					<group>
						<group>
							<field name="manager_id" widget="many2one_avatar_employee" readonly="state != 'new'"/>
							<field name="department_id"/>
							<field name="template_id" readonly="state != 'new'"/>
						</group>
						<group>
							<label for="date_from" string="Period"/>
							<div class="o_row">
								<field name="date_from" readonly="state != 'new'"/> - <field name="date_to" readonly="state != 'new'"/>
							</div>
							<field name="deadline" readonly="state in ('done', 'cancel')"/>
							<field name="score" widget="float" digits="[2, 1]" invisible="not score"/>
							<field name="result" invisible="not result"/>
						</group>
					</group>
					<field name="is_employee" invisible="1"/>
					<field name="is_manager" invisible="1"/>
					<notebook invisible="state == 'new'">
						<page string="Questions" name="questions">
							<field name="line_ids" readonly="state in ('done', 'cancel')">
								<list editable="bottom" create="0" delete="0">
									<field name="sequence" column_invisible="True"/>
									<field name="kind" column_invisible="True"/>
									<field name="name" readonly="1"/>
									<field name="employee_rating" widget="priority" invisible="kind != 'rating'" readonly="not parent.is_employee"/>
									<field name="employee_comment" readonly="not parent.is_employee"/>
									<field name="manager_rating" widget="priority" invisible="kind != 'rating'" readonly="not parent.is_manager"/>
									<field name="manager_comment" readonly="not parent.is_manager"/>
									<field name="weight" optional="hide" readonly="1"/>
								</list>
							</field>
						</page>
						<page string="Comments" name="comments">
							<group>
								<field name="employee_feedback" readonly="not is_employee or state in ('done', 'cancel')"/>
								<field name="manager_feedback" readonly="not is_manager or state in ('done', 'cancel')"/>
							</group>
						</page>
					</notebook>
				</sheet>
				<chatter/>
			</form>
		</field>
	</record>

	<record id="appraisal_view_list" model="ir.ui.view">
		<field name="name">veron.appraisal.list</field>
		<field name="model">veron.appraisal</field>
		<field name="arch" type="xml">
			<list>
				<field name="employee_id" widget="many2one_avatar_employee"/>
				<field name="manager_id" widget="many2one_avatar_employee"/>
				<field name="department_id" optional="show"/>
				<field name="date_from"/>
				<field name="date_to"/>
				<field name="deadline" optional="show"/>
				<field name="score" widget="float" digits="[2, 1]"/>
				<field name="result" optional="show"/>
				<field name="state" widget="badge" decoration-info="state == 'pending'" decoration-success="state == 'done'"/>
			</list>
		</field>
	</record>

	<record id="appraisal_view_kanban" model="ir.ui.view">
		<field name="name">veron.appraisal.kanban</field>
		<field name="model">veron.appraisal</field>
		<field name="arch" type="xml">
			<kanban default_group_by="state" group_create="0" group_delete="0" quick_create="0">
				<field name="state"/>
				<templates>
					<t t-name="card">
						<field name="employee_id" widget="many2one_avatar_employee" class="fw-bold"/>
						<field name="department_id" class="text-muted"/>
						<div class="d-flex justify-content-between mt-2">
							<span><field name="date_to"/></span>
							<field name="score" widget="float" digits="[2, 1]" invisible="not score"/>
						</div>
						<field name="activity_ids" widget="kanban_activity"/>
					</t>
				</templates>
			</kanban>
		</field>
	</record>

	<record id="appraisal_view_search" model="ir.ui.view">
		<field name="name">veron.appraisal.search</field>
		<field name="model">veron.appraisal</field>
		<field name="arch" type="xml">
			<search>
				<field name="employee_id"/>
				<field name="manager_id"/>
				<field name="department_id"/>
				<filter name="mine" string="My Appraisals" domain="[('employee_user_id', '=', uid)]"/>
				<filter name="my_team" string="My Team" domain="[('manager_user_id', '=', uid)]"/>
				<filter name="pending" string="In Progress" domain="[('state', '=', 'pending')]"/>
				<separator/>
				<filter name="period" string="Period" date="date_to"/>
				<group>
					<filter name="by_department" string="Department" context="{'group_by': 'department_id'}"/>
					<filter name="by_result" string="Result" context="{'group_by': 'result'}"/>
				</group>
			</search>
		</field>
	</record>

	<record id="appraisal_view_pivot" model="ir.ui.view">
		<field name="name">veron.appraisal.pivot</field>
		<field name="model">veron.appraisal</field>
		<field name="arch" type="xml">
			<pivot>
				<field name="department_id" type="row"/>
				<field name="date_to" interval="year" type="col"/>
				<field name="score" type="measure"/>
			</pivot>
		</field>
	</record>

	<record id="action_appraisals" model="ir.actions.act_window">
		<field name="name">Appraisals</field>
		<field name="res_model">veron.appraisal</field>
		<field name="view_mode">kanban,list,form,pivot,activity</field>
		<field name="help" type="html">
			<p class="o_view_nocontent_smiling_face">Start the first appraisal</p>
			<p>Or select employees in Employees and use «Start Appraisals» from the Actions menu.</p>
		</field>
	</record>

	<record id="template_view_form" model="ir.ui.view">
		<field name="name">veron.appraisal.template.form</field>
		<field name="model">veron.appraisal.template</field>
		<field name="arch" type="xml">
			<form>
				<sheet>
					<div class="oe_title"><h1><field name="name" placeholder="Form name"/></h1></div>
					<field name="line_ids">
						<list editable="bottom">
							<field name="sequence" widget="handle"/>
							<field name="name"/>
							<field name="kind"/>
							<field name="weight"/>
						</list>
					</field>
				</sheet>
			</form>
		</field>
	</record>

	<record id="action_templates" model="ir.actions.act_window">
		<field name="name">Appraisal Forms</field>
		<field name="res_model">veron.appraisal.template</field>
		<field name="view_mode">list,form</field>
	</record>

	<record id="action_start_appraisals" model="ir.actions.server">
		<field name="name">Start Appraisals</field>
		<field name="model_id" ref="hr.model_hr_employee"/>
		<field name="binding_model_id" ref="hr.model_hr_employee"/>
		<field name="binding_view_types">list,kanban</field>
		<field name="state">code</field>
		<field name="code">action = records.action_veron_start_appraisals()</field>
		<field name="group_ids" eval="[(4, ref('hr.group_hr_user'))]"/>
	</record>

	<record id="employee_view_form" model="ir.ui.view">
		<field name="name">hr.employee.form.veron.appraisal</field>
		<field name="model">hr.employee</field>
		<field name="inherit_id" ref="hr.view_employee_form"/>
		<field name="arch" type="xml">
			<div name="button_box" position="inside">
				<button name="action_veron_appraisals" type="object" class="oe_stat_button" icon="fa-star-half-o" groups="hr.group_hr_user">
					<field name="veron_appraisal_count" widget="statinfo" string="Appraisals"/>
				</button>
			</div>
		</field>
	</record>

	<menuitem id="menu_root" name="Appraisals" web_icon="veron_appraisal,static/description/icon.png" sequence="56"/>
	<menuitem id="menu_appraisals" name="Appraisals" parent="menu_root" action="action_appraisals" sequence="1"/>
	<menuitem id="menu_config" name="Configuration" parent="menu_root" sequence="10" groups="hr.group_hr_user"/>
	<menuitem id="menu_templates" name="Appraisal Forms" parent="menu_config" action="action_templates"/>
</odoo>
