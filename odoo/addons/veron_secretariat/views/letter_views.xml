<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="letter_view_list" model="ir.ui.view">
		<field name="name">veron.letter.list</field>
		<field name="model">veron.letter</field>
		<field name="arch" type="xml">
			<list decoration-danger="priority == '2'" decoration-warning="priority == '1'" decoration-muted="state == 'archived'">
				<field name="name"/>
				<field name="kind"/>
				<field name="date"/>
				<field name="subject"/>
				<field name="partner_id"/>
				<field name="classification" optional="show"/>
				<field name="priority" widget="priority" optional="show"/>
				<field name="state" widget="badge"/>
			</list>
		</field>
	</record>
	<record id="letter_view_form" model="ir.ui.view">
		<field name="name">veron.letter.form</field>
		<field name="model">veron.letter</field>
		<field name="arch" type="xml">
			<form>
				<header>
					<button name="action_register" type="object" string="Register" class="btn-primary" invisible="state != 'draft'"/>
					<button name="action_archive_letter" type="object" string="Archive" invisible="state != 'registered'"/>
					<field name="state" widget="statusbar"/>
				</header>
				<sheet>
					<div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
					<group>
						<group>
							<field name="kind" readonly="state != 'draft'"/>
							<field name="date" readonly="state != 'draft'"/>
							<field name="subject"/>
							<field name="partner_id" invisible="kind == 'internal'" required="kind == 'incoming'"/>
							<field name="user_ids" widget="many2many_tags"/>
						</group>
						<group>
							<field name="their_number" invisible="kind != 'incoming'"/>
							<field name="their_date" invisible="kind != 'incoming'"/>
							<field name="signer_id" invisible="kind == 'incoming'"/>
							<field name="priority" widget="priority"/>
							<field name="classification"/>
							<field name="enclosure"/>
						</group>
					</group>
					<notebook>
						<page string="Text" name="body"><field name="body"/></page>
						<page string="Referrals" name="referrals">
							<field name="referral_ids">
								<list editable="bottom">
									<field name="from_id"/>
									<field name="user_id"/>
									<field name="instruction"/>
									<field name="deadline"/>
									<field name="answer"/>
									<field name="state" widget="badge"/>
									<button name="action_done" type="object" string="Done" invisible="state != 'pending'"/>
								</list>
							</field>
						</page>
						<page string="Related Letters" name="related">
							<group>
								<field name="follows_id"/>
								<field name="reference_id"/>
								<field name="answers_id"/>
							</group>
						</page>
					</notebook>
				</sheet>
				<chatter/>
			</form>
		</field>
	</record>
	<record id="letter_view_search" model="ir.ui.view">
		<field name="name">veron.letter.search</field>
		<field name="model">veron.letter</field>
		<field name="arch" type="xml">
			<search>
				<field name="name"/>
				<field name="subject"/>
				<field name="partner_id"/>
				<field name="their_number"/>
				<filter name="incoming" string="Incoming" domain="[('kind', '=', 'incoming')]"/>
				<filter name="outgoing" string="Outgoing" domain="[('kind', '=', 'outgoing')]"/>
				<filter name="internal" string="Internal" domain="[('kind', '=', 'internal')]"/>
				<separator/>
				<filter name="mine" string="Referred to Me" domain="[('referral_ids.user_id', '=', uid), ('referral_ids.state', '=', 'pending')]"/>
				<group>
					<filter name="by_kind" string="Kind" context="{'group_by': 'kind'}"/>
					<filter name="by_month" string="Month" context="{'group_by': 'date:month'}"/>
				</group>
			</search>
		</field>
	</record>
	<record id="action_letters" model="ir.actions.act_window">
		<field name="name">Letters</field>
		<field name="res_model">veron.letter</field>
		<field name="view_mode">list,form</field>
	</record>
	<menuitem id="menu_root" name="Secretariat" web_icon="veron_secretariat,static/description/icon.png" sequence="45"/>
	<menuitem id="menu_letters" name="Letters" parent="menu_root" action="action_letters" sequence="1"/>
</odoo>
