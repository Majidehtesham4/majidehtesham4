<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="shift_view_timeline" model="ir.ui.view">
		<field name="name">veron.planning.shift.timeline</field>
		<field name="model">veron.planning.shift</field>
		<field name="type">timeline</field>
		<field name="arch" type="xml">
			<timeline date_start="start_datetime" date_stop="end_datetime" default_group_by="employee_id"
				event_open_popup="true" colors="#ec7063: conflict == true; #95a5a6: state == 'draft'">
				<field name="role_id"/>
				<field name="state"/>
				<field name="conflict"/>
				<field name="allocated_hours"/>
				<templates>
					<t t-name="timeline-item">
						<div class="o_veron_planning_item">
							<span t-esc="record.role_id and record.role_id[1] or ''"/>
							<small class="ms-1" t-if="record.allocated_hours" t-out="formatters.get('float_time')(record.allocated_hours)"/>
						</div>
					</t>
				</templates>
			</timeline>
		</field>
	</record>

	<record id="shift_view_calendar" model="ir.ui.view">
		<field name="name">veron.planning.shift.calendar</field>
		<field name="model">veron.planning.shift</field>
		<field name="arch" type="xml">
			<calendar date_start="start_datetime" date_stop="end_datetime" color="employee_id" mode="week" event_open_popup="true" quick_create="false">
				<field name="employee_id" filters="1"/>
				<field name="role_id" filters="1"/>
				<field name="allocated_hours" widget="float_time"/>
				<field name="state"/>
			</calendar>
		</field>
	</record>

	<record id="shift_view_list" model="ir.ui.view">
		<field name="name">veron.planning.shift.list</field>
		<field name="model">veron.planning.shift</field>
		<field name="arch" type="xml">
			<list decoration-danger="conflict" decoration-muted="state == 'draft'" multi_edit="1">
				<header>
					<button name="action_publish" type="object" string="Publish" groups="hr.group_hr_user"/>
				</header>
				<field name="employee_id" widget="many2one_avatar_employee"/>
				<field name="role_id"/>
				<field name="start_datetime"/>
				<field name="end_datetime"/>
				<field name="allocated_hours" widget="float_time" sum="Total"/>
				<field name="conflict" column_invisible="True"/>
				<field name="conflict_reason" optional="show"/>
				<field name="state" widget="badge" decoration-success="state == 'published'"/>
			</list>
		</field>
	</record>

	<record id="shift_view_form" model="ir.ui.view">
		<field name="name">veron.planning.shift.form</field>
		<field name="model">veron.planning.shift</field>
		<field name="arch" type="xml">
			<form>
				<header>
					<button name="action_publish" type="object" string="Publish" class="btn-primary" invisible="state != 'draft'" groups="hr.group_hr_user"/>
					<button name="action_draft" type="object" string="Back to Draft" invisible="state != 'published'" groups="hr.group_hr_user"/>
					<field name="state" widget="statusbar"/>
				</header>
				<sheet>
					<div class="alert alert-warning" role="alert" invisible="not conflict">
						<i class="fa fa-exclamation-triangle me-1"/> Conflict: <field name="conflict_reason" class="d-inline"/>
					</div>
					<group>
						<group>
							<field name="employee_id" widget="many2one_avatar_employee"/>
							<field name="role_id"/>
							<field name="company_id" groups="base.group_multi_company"/>
						</group>
						<group>
							<field name="start_datetime"/>
							<field name="end_datetime"/>
							<field name="allocated_hours" widget="float_time"/>
						</group>
					</group>
					<field name="note" placeholder="Notes for the employee..."/>
					<field name="conflict" invisible="1"/>
				</sheet>
				<chatter/>
			</form>
		</field>
	</record>

	<record id="shift_view_search" model="ir.ui.view">
		<field name="name">veron.planning.shift.search</field>
		<field name="model">veron.planning.shift</field>
		<field name="arch" type="xml">
			<search>
				<field name="employee_id"/>
				<field name="role_id"/>
				<field name="department_id"/>
				<filter name="mine" string="My Shifts" domain="[('user_id', '=', uid)]"/>
				<filter name="conflicts" string="Conflicts" domain="[('conflict', '=', True)]"/>
				<filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
				<filter name="published" string="Published" domain="[('state', '=', 'published')]"/>
				<separator/>
				<filter name="start" string="Date" date="start_datetime"/>
				<group>
					<filter name="by_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
					<filter name="by_role" string="Role" context="{'group_by': 'role_id'}"/>
					<filter name="by_department" string="Department" context="{'group_by': 'department_id'}"/>
				</group>
			</search>
		</field>
	</record>

	<record id="shift_view_pivot" model="ir.ui.view">
		<field name="name">veron.planning.shift.pivot</field>
		<field name="model">veron.planning.shift</field>
		<field name="arch" type="xml">
			<pivot>
				<field name="employee_id" type="row"/>
				<field name="start_datetime" interval="week" type="col"/>
				<field name="allocated_hours" type="measure" widget="float_time"/>
			</pivot>
		</field>
	</record>

	<record id="action_shifts" model="ir.actions.act_window">
		<field name="name">Planning</field>
		<field name="res_model">veron.planning.shift</field>
		<field name="view_mode">timeline,calendar,list,form,pivot</field>
		<field name="help" type="html">
			<p class="o_view_nocontent_smiling_face">Plan the first shift</p>
			<p>Who works when, in which role. Publish the plan so the employees see it.</p>
		</field>
	</record>

	<record id="action_my_shifts" model="ir.actions.act_window">
		<field name="name">My Shifts</field>
		<field name="res_model">veron.planning.shift</field>
		<field name="view_mode">calendar,list,form</field>
		<field name="context">{'search_default_mine': 1}</field>
	</record>

	<record id="action_roles" model="ir.actions.act_window">
		<field name="name">Roles</field>
		<field name="res_model">veron.planning.role</field>
		<field name="view_mode">list,form</field>
	</record>

	<record id="role_view_list" model="ir.ui.view">
		<field name="name">veron.planning.role.list</field>
		<field name="model">veron.planning.role</field>
		<field name="arch" type="xml">
			<list editable="bottom">
				<field name="sequence" widget="handle"/>
				<field name="name"/>
				<field name="color" widget="color_picker"/>
			</list>
		</field>
	</record>

	<record id="action_copy_previous_week" model="ir.actions.server">
		<field name="name">Copy Previous Week</field>
		<field name="model_id" ref="model_veron_planning_shift"/>
		<field name="state">code</field>
		<field name="code">action = model.action_copy_previous_week()</field>
		<field name="group_ids" eval="[(4, ref('hr.group_hr_user'))]"/>
	</record>

	<menuitem id="menu_planning_root" name="Planning" web_icon="veron_planning,static/description/icon.png" sequence="55"/>
	<menuitem id="menu_planning" name="Planning" parent="menu_planning_root" action="action_shifts" sequence="1" groups="hr.group_hr_user"/>
	<menuitem id="menu_my_shifts" name="My Shifts" parent="menu_planning_root" action="action_my_shifts" sequence="2"/>
	<menuitem id="menu_copy_week" name="Copy Previous Week" parent="menu_planning_root" action="action_copy_previous_week" sequence="3" groups="hr.group_hr_user"/>
	<menuitem id="menu_config" name="Configuration" parent="menu_planning_root" sequence="10" groups="hr.group_hr_user"/>
	<menuitem id="menu_roles" name="Roles" parent="menu_config" action="action_roles"/>
</odoo>
