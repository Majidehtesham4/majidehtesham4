<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<!-- Employees see the published plan; HR officers plan -->
	<record id="rule_shift_published" model="ir.rule">
		<field name="name">Shifts: the published plan, and one's own</field>
		<field name="model_id" ref="model_veron_planning_shift"/>
		<field name="groups" eval="[(4, ref('base.group_user'))]"/>
		<field name="domain_force">['|', ('state', '=', 'published'), ('user_id', '=', user.id)]</field>
	</record>
	<record id="rule_shift_hr" model="ir.rule">
		<field name="name">Shifts: all, for HR officers</field>
		<field name="model_id" ref="model_veron_planning_shift"/>
		<field name="groups" eval="[(4, ref('hr.group_hr_user'))]"/>
		<field name="domain_force">[(1, '=', 1)]</field>
	</record>
	<record id="rule_shift_company" model="ir.rule">
		<field name="name">Shifts: the user's companies</field>
		<field name="model_id" ref="model_veron_planning_shift"/>
		<field name="global" eval="True"/>
		<field name="domain_force">[('company_id', 'in', company_ids)]</field>
	</record>
</odoo>
