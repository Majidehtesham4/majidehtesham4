<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="hr_payslip_view_form" model="ir.ui.view">
		<field name="name">hr.payslip.form.iran</field>
		<field name="model">hr.payslip</field>
		<field name="inherit_id" ref="payroll.hr_payslip_view_form"/>
		<field name="arch" type="xml">
			<div name="button_box" position="inside">
				<button name="action_veron_open_move" type="object" class="oe_stat_button" icon="fa-book" invisible="not veron_move_id"
					groups="account.group_account_invoice">
					<span>Accounting Entry</span>
				</button>
			</div>
			<field name="paid" position="before">
				<field name="veron_move_id" groups="account.group_account_invoice"/>
			</field>
		</field>
	</record>
</odoo>
