<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="hr_employee_view_form" model="ir.ui.view">
		<field name="name">hr.employee.form.payroll.iran</field>
		<field name="model">hr.employee</field>
		<field name="inherit_id" ref="hr.view_employee_form"/>
		<field name="arch" type="xml">
			<xpath expr="//group[@name='contract']" position="inside">
				<field name="struct_id"/>
				<field name="veron_seniority"/>
				<field name="veron_other_allowance"/>
				<field name="veron_insured"/>
				<field name="veron_insurance_number" invisible="not veron_insured"/>
			</xpath>
		</field>
	</record>

	<record id="hr_contract_template_view_form" model="ir.ui.view">
		<field name="name">hr.version.form.payroll.iran</field>
		<field name="model">hr.version</field>
		<field name="inherit_id" ref="hr.hr_contract_template_form_view"/>
		<field name="arch" type="xml">
			<xpath expr="//group[@name='contract']" position="inside">
				<field name="veron_seniority"/>
				<field name="veron_other_allowance"/>
				<field name="veron_insured"/>
			</xpath>
		</field>
	</record>
</odoo>
