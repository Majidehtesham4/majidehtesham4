	<record id="rule_bonus" model="hr.salary.rule">
		<field name="name">پاداش</field>
		<field name="code">BONUS</field>
		<field name="sequence">35</field>
		<field name="category_id" ref="categ_alw"/>
		<field name="condition_select">python</field>
		<field name="condition_python">result = bool(inputs.BONUS and inputs.BONUS.amount)</field>
		<field name="amount_select">code</field>
		<field name="amount_python_compute">result = inputs.BONUS.amount</field>
		<field name="veron_debit_code">611010</field>
	</record>
	<record id="input_bonus" model="hr.rule.input">
		<field name="name">پاداش (مبلغ)</field>
		<field name="code">BONUS</field>
		<field name="input_id" ref="rule_bonus"/>
	</record>
	<record id="rule_gross" model="hr.salary.rule">
		<field name="name">جمع حقوق و مزایا</field>
		<field name="code">GROSS</field>
		<field name="sequence">50</field>
		<field name="category_id" ref="categ_gross"/>
		<field name="condition_select">none</field>
		<field name="amount_select">code</field>
		<field name="amount_python_compute">result = categories.BASIC + categories.ALW</field>
	</record>
	<record id="rule_insb" model="hr.salary.rule">
		<field name="name">حقوق مشمول بیمه</field>
		<field name="code">INSB</field>
		<field name="sequence">55</field>
		<field name="category_id" ref="categ_insbase"/>
		<field name="condition_select">python</field>
		<field name="condition_python">result = contract.veron_insured</field>
		<field name="amount_select">code</field>
		<field name="amount_python_compute">result = min(categories.GROSS - categories.NOINS, round(iran.insurance_ceiling / 30 * iran.days))</field>
		<field name="appears_on_payslip" eval="False"/>
		<field name="note">جمع حقوق و مزایا بدون حق اولاد، حداکثر تا سقف دستمزد مشمول بیمه</field>
	</record>
	<record id="rule_ins_emp" model="hr.salary.rule">
		<field name="name">حق بیمه سهم کارمند</field>
		<field name="code">INS_EMP</field>
		<field name="sequence">60</field>
		<field name="category_id" ref="categ_insded"/>
		<field name="condition_select">python</field>
		<field name="condition_python">result = contract.veron_insured</field>
		<field name="amount_select">code</field>
		<field name="amount_python_compute">result = -round(INSB * iran.ins_employee)</field>
		<field name="veron_credit_code">211204</field>
	</record>
	<record id="rule_taxb" model="hr.salary.rule">
		<field name="name">حقوق مشمول مالیات</field>
		<field name="code">TAXB</field>
		<field name="sequence">65</field>
		<field name="category_id" ref="categ_basex"/>
		<field name="condition_select">none</field>
		<field name="amount_select">code</field>
		<field name="amount_python_compute">result = max(categories.GROSS - categories.INSBASE * iran.tax_exempt_insurance, 0)</field>
		<field name="appears_on_payslip" eval="False"/>
		<field name="note">جمع حقوق و مزایا منهای سهم معاف حق بیمه‌ی کارمند (دو هفتم ۷٪ = ۲٪ حقوق مشمول بیمه)</field>
	</record>
	<record id="rule_tax" model="hr.salary.rule">
		<field name="name">مالیات حقوق</field>
		<field name="code">TAX</field>
		<field name="sequence">70</field>
		<field name="category_id" ref="categ_ded"/>
		<field name="condition_select">none</field>
		<field name="amount_select">code</field>
		<field name="amount_python_compute">result = -iran.tax(TAXB)</field>
		<field name="veron_credit_code">211202</field>
		<field name="note">پلکانی، با جدول معافیت و نرخ‌های سال</field>
	</record>
	<record id="rule_loan" model="hr.salary.rule">
		<field name="name">قسط وام</field>
		<field name="code">LOAN</field>
		<field name="sequence">75</field>
		<field name="category_id" ref="categ_ded"/>
		<field name="condition_select">python</field>
		<field name="condition_python">result = bool(inputs.LOAN and inputs.LOAN.amount)</field>
		<field name="amount_select">code</field>
		<field name="amount_python_compute">result = -inputs.LOAN.amount</field>
		<field name="veron_credit_code">111401</field>
		<field name="veron_partner" eval="True"/>
	</record>
	<record id="input_loan" model="hr.rule.input">
		<field name="name">قسط وام (مبلغ)</field>
		<field name="code">LOAN</field>
		<field name="input_id" ref="rule_loan"/>
	</record>
	<record id="rule_advance" model="hr.salary.rule">
		<field name="name">مساعده</field>
		<field name="code">ADVANCE</field>
		<field name="sequence">76</field>
		<field name="category_id" ref="categ_ded"/>
		<field name="condition_select">python</field>
		<field name="condition_python">result = bool(inputs.ADVANCE and inputs.ADVANCE.amount)</field>
		<field name="amount_select">code</field>
		<field name="amount_python_compute">result = -inputs.ADVANCE.amount</field>
		<field name="veron_credit_code">111401</field>
		<field name="veron_partner" eval="True"/>
	</record>
	<record id="input_advance" model="hr.rule.input">
		<field name="name">مساعده (مبلغ)</field>
		<field name="code">ADVANCE</field>
		<field name="input_id" ref="rule_advance"/>
	</record>
	<record id="rule_otherded" model="hr.salary.rule">
		<field name="name">سایر کسورات</field>
		<field name="code">OTHERDED</field>
		<field name="sequence">77</field>
		<field name="category_id" ref="categ_ded"/>
		<field name="condition_select">python</field>
		<field name="condition_python">result = bool(inputs.OTHERDED and inputs.OTHERDED.amount)</field>
		<field name="amount_select">code</field>
		<field name="amount_python_compute">result = -inputs.OTHERDED.amount</field>
		<field name="veron_credit_code">111407</field>
		<field name="veron_partner" eval="True"/>
	</record>
	<record id="input_otherded" model="hr.rule.input">
		<field name="name">سایر کسورات (مبلغ)</field>
		<field name="code">OTHERDED</field>
		<field name="input_id" ref="rule_otherded"/>
	</record>
	<record id="rule_net" model="hr.salary.rule">
		<field name="name">خالص پرداختی</field>
		<field name="code">NET</field>
		<field name="sequence">80</field>
		<field name="category_id" ref="categ_net"/>
		<field name="condition_select">none</field>
		<field name="amount_select">code</field>
		<field name="amount_python_compute">result = categories.GROSS + categories.DED</field>
		<field name="veron_credit_code">211208</field>
		<field name="veron_partner" eval="True"/>
	</record>
	<record id="rule_ins_er" model="hr.salary.rule">
		<field name="name">حق بیمه سهم کارفرما</field>
		<field name="code">INS_ER</field>
		<field name="sequence">90</field>
		<field name="category_id" ref="categ_comp"/>
		<field name="condition_select">python</field>
		<field name="condition_python">result = contract.veron_insured</field>
		<field name="amount_select">code</field>
		<field name="amount_python_compute">result = round(INSB * iran.ins_employer)</field>
		<field name="veron_debit_code">611011</field>
		<field name="veron_credit_code">211204</field>
	</record>
	<record id="rule_ins_un" model="hr.salary.rule">
		<field name="name">بیمه بیکاری</field>
		<field name="code">INS_UN</field>
		<field name="sequence">91</field>
		<field name="category_id" ref="categ_comp"/>
		<field name="condition_select">python</field>
		<field name="condition_python">result = contract.veron_insured</field>
		<field name="amount_select">code</field>
		<field name="amount_python_compute">result = round(INSB * iran.ins_unemployment)</field>
		<field name="veron_debit_code">611016</field>
		<field name="veron_credit_code">211204</field>
	</record>
	<record id="rule_eidi" model="hr.salary.rule">
		<field name="name">ذخیره عیدی و پاداش</field>
		<field name="code">EIDI</field>
		<field name="sequence">95</field>
		<field name="category_id" ref="categ_prov"/>
		<field name="condition_select">none</field>
		<field name="amount_select">code</field>
		<field name="amount_python_compute">result = round(min(contract.wage * iran.eidi_months, iran.min_monthly * iran.eidi_cap) / 12 * iran.ratio)</field>
		<field name="veron_debit_code">611008</field>
		<field name="veron_credit_code">211212</field>
		<field name="note">ماده‌ی ۱ قانون عیدی: شصت روز آخرین مزد، حداکثر نود روز حداقل مزد، به نسبت روزهای کار در سال؛ ماهانه یک دوازدهم</field>
	</record>
	<record id="rule_sanavat" model="hr.salary.rule">
		<field name="name">ذخیره سنوات</field>
		<field name="code">SANAVAT</field>
		<field name="sequence">96</field>
		<field name="category_id" ref="categ_prov"/>
		<field name="condition_select">none</field>
		<field name="amount_select">code</field>
		<field name="amount_python_compute">result = round((contract.wage + contract.veron_seniority) / 12 * iran.ratio)</field>
		<field name="veron_debit_code">611013</field>
		<field name="veron_credit_code">221305</field>
		<field name="note">ماده‌ی ۲۷ قانون کار: برای هر سال یک ماه آخرین مزد؛ ماهانه یک دوازدهم</field>
	</record>
	<record id="structure_iran" model="hr.payroll.structure">
		<field name="rule_ids" eval="[(6, 0, [ref('rule_base'), ref('rule_seniority'), ref('rule_housing'), ref('rule_food'), ref('rule_child'), ref('rule_marriage'), ref('rule_other'), ref('rule_overtime'), ref('rule_night'), ref('rule_holidaywork'), ref('rule_bonus'), ref('rule_gross'), ref('rule_insb'), ref('rule_ins_emp'), ref('rule_taxb'), ref('rule_tax'), ref('rule_loan'), ref('rule_advance'), ref('rule_otherded'), ref('rule_net'), ref('rule_ins_er'), ref('rule_ins_un'), ref('rule_eidi'), ref('rule_sanavat')])]"/>
	</record>
</odoo>
