		<field name="code">FOOD</field>
		<field name="sequence">21</field>
		<field name="category_id" ref="categ_alw"/>
		<field name="condition_select">python</field>
		<field name="condition_python">result = bool(iran.food)</field>
		<field name="amount_select">code</field>
		<field name="amount_python_compute">result = round(iran.food * iran.ratio)</field>
		<field name="veron_debit_code">611009</field>
	</record>
	<record id="rule_child" model="hr.salary.rule">
		<field name="name">حق اولاد</field>
		<field name="code">CHILD</field>
		<field name="sequence">22</field>
		<field name="category_id" ref="categ_noins"/>
		<field name="condition_select">python</field>
		<field name="condition_python">result = contract.children &gt; 0</field>
		<field name="amount_select">code</field>
		<field name="amount_python_compute">result = round(iran.child * iran.ratio)
result_qty = contract.children</field>
		<field name="veron_debit_code">611007</field>
		<field name="note">برای هر فرزند سه برابر حداقل مزد روزانه؛ به شرط ۷۲۰ روز سابقه‌ی بیمه. حق اولاد مشمول کسر حق بیمه نیست.</field>
	</record>
	<record id="rule_marriage" model="hr.salary.rule">
		<field name="name">حق تأهل</field>
		<field name="code">MARRIAGE</field>
		<field name="sequence">23</field>
		<field name="category_id" ref="categ_alw"/>
		<field name="condition_select">python</field>
		<field name="condition_python">result = contract.marital == 'married'</field>
		<field name="amount_select">code</field>
		<field name="amount_python_compute">result = round(iran.marriage * iran.ratio)</field>
		<field name="veron_debit_code">611018</field>
