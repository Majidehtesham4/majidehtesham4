	<record id="structure_iran" model="hr.payroll.structure">
		<field name="name">قانون کار ایران</field>
		<field name="code">IR</field>
		<field name="note">حقوق و مزایا، بیمه‌ی تأمین اجتماعی و مالیات حقوق بر اساس قانون کار؛ با نرخ‌های تأییدشده‌ی هر سال</field>
	</record>
	<record id="rule_base" model="hr.salary.rule">
		<field name="name">حقوق پایه</field>
		<field name="code">BASE</field>
		<field name="sequence">10</field>
		<field name="category_id" ref="categ_basic"/>
		<field name="condition_select">none</field>
		<field name="amount_select">code</field>
		<field name="amount_python_compute">result = round(contract.wage / 30)
result_qty = iran.days</field>
		<field name="veron_debit_code">611001</field>
		<field name="note">مزد روزانه (مزد ماهانه‌ی قرارداد تقسیم بر ۳۰) ضرب در روزهای ماه شمسی منهای غیبت</field>
	</record>
	<record id="input_absence" model="hr.rule.input">
