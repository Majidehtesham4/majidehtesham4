		<field name="input_id" ref="rule_base"/>
	</record>
	<record id="rule_seniority" model="hr.salary.rule">
		<field name="name">پایه سنوات</field>
		<field name="code">SENIORITY</field>
		<field name="sequence">15</field>
		<field name="category_id" ref="categ_basic"/>
		<field name="condition_select">python</field>
		<field name="condition_python">result = bool(contract.veron_seniority)</field>
		<field name="amount_select">code</field>
		<field name="amount_python_compute">result = round(contract.veron_seniority * iran.ratio)</field>
		<field name="veron_debit_code">611001</field>
	</record>
