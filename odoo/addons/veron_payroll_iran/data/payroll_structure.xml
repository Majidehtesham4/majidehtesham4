	<record id="rule_overtime" model="hr.salary.rule">
		<field name="name">اضافه‌کاری</field>
		<field name="code">OVERTIME</field>
		<field name="sequence">30</field>
		<field name="category_id" ref="categ_alw"/>
		<field name="condition_select">python</field>
		<field name="condition_python">result = bool(inputs.OVERTIME and inputs.OVERTIME.amount)</field>
		<field name="amount_select">code</field>
		<field name="amount_python_compute">result = round(contract.wage / iran.monthly_hours * iran.overtime_rate)
result_qty = inputs.OVERTIME.amount</field>
		<field name="veron_debit_code">611002</field>
		<field name="note">ماده‌ی ۵۹ قانون کار: مزد هر ساعت به اضافه‌ی ۴۰٪</field>
	</record>
	<record id="input_overtime" model="hr.rule.input">
		<field name="name">اضافه‌کاری (ساعت)</field>
		<field name="code">OVERTIME</field>
		<field name="input_id" ref="rule_overtime"/>
	</record>
	<record id="rule_night" model="hr.salary.rule">
		<field name="name">شب‌کاری</field>
		<field name="code">NIGHT</field>
		<field name="sequence">31</field>
		<field name="category_id" ref="categ_alw"/>
		<field name="condition_select">python</field>
		<field name="condition_python">result = bool(inputs.NIGHT and inputs.NIGHT.amount)</field>
		<field name="amount_select">code</field>
		<field name="amount_python_compute">result = round(contract.wage / iran.monthly_hours * iran.night_rate)
result_qty = inputs.NIGHT.amount</field>
		<field name="veron_debit_code">611003</field>
		<field name="note">ماده‌ی ۵۸ قانون کار: ۳۵٪ مزد هر ساعت، افزون بر مزد همان ساعت</field>
	</record>
	<record id="input_night" model="hr.rule.input">
		<field name="name">شب‌کاری (ساعت، ۲۲ تا ۶)</field>
		<field name="code">NIGHT</field>
		<field name="input_id" ref="rule_night"/>
	</record>
	<record id="rule_holidaywork" model="hr.salary.rule">
