<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="module_category_dealership" model="ir.module.category">
		<field name="name">Showroom</field>
		<field name="sequence">20</field>
	</record>
	<record id="privilege_dealership" model="res.groups.privilege">
		<field name="name">Showroom</field>
		<field name="category_id" ref="module_category_dealership"/>
	</record>
	<record id="group_dealership_reception" model="res.groups">
		<field name="name">Reception</field>
		<field name="privilege_id" ref="privilege_dealership"/>
		<field name="comment">Registers the cars that come in, their documents, body and inspection, and the costs.</field>
	</record>
	<record id="group_dealership_user" model="res.groups">
		<field name="name">Salesperson</field>
		<field name="privilege_id" ref="privilege_dealership"/>
		<field name="implied_ids" eval="[(4, ref('group_dealership_reception'))]"/>
		<field name="comment">Also reserves and sells cars, and makes instalment sales.</field>
	</record>
	<record id="group_dealership_manager" model="res.groups">
		<field name="name">Manager</field>
		<field name="privilege_id" ref="privilege_dealership"/>
		<field name="implied_ids" eval="[(4, ref('group_dealership_user'))]"/>
		<field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
		<field name="comment">Also sees the purchase prices, the lowest prices and the profit, and the investors.</field>
	</record>

	<record id="rule_vehicle_company" model="ir.rule">
		<field name="name">Vehicles: own companies</field>
		<field name="model_id" ref="model_veron_vehicle"/>
		<field name="domain_force">[('company_id', 'in', company_ids)]</field>
	</record>
	<record id="rule_instalment_company" model="ir.rule">
		<field name="name">Instalment sales: own companies</field>
		<field name="model_id" ref="model_veron_instalment_sale"/>
		<field name="domain_force">[('company_id', 'in', company_ids)]</field>
	</record>
	<record id="rule_investment_company" model="ir.rule">
		<field name="name">Investment contracts: own companies</field>
		<field name="model_id" ref="model_veron_investment_contract"/>
		<field name="domain_force">[('company_id', 'in', company_ids)]</field>
	</record>
</odoo>
