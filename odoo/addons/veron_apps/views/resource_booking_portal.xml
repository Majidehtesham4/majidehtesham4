<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<!-- The booking page's month from what _get_calendar_context gives (Shamsi in Persian):
	     its days, title, next and previous month, and the dates of the confirmation -->
	<template id="scheduling_calendar_shamsi" inherit_id="resource_booking.scheduling_calendar">
		<xpath expr="//t[@t-set='start_next']" position="attributes">
			<attribute name="t-value">next_month</attribute>
		</xpath>
		<xpath expr="//t[@t-set='start_previous']" position="attributes">
			<attribute name="t-value">previous_month</attribute>
		</xpath>
		<xpath expr="//th[@t-out=&quot;start.strftime('%B %Y')&quot;]" position="attributes">
			<attribute name="t-out">month_title</attribute>
		</xpath>
		<xpath expr="//th[@t-att-title='weekday_names[str(weekday + 1)]']" position="attributes">
			<attribute name="t-out">weekday_names[str(weekday + 1)] if res_lang.code.startswith('fa') else weekday_names[str(weekday + 1)][:3]</attribute>
		</xpath>
		<xpath expr="//td[@t-att-class=&quot;day.month != start.month and 'text-muted'&quot;]" position="attributes">
			<attribute name="t-att-class">day not in month_days and 'text-muted'</attribute>
		</xpath>
		<xpath expr="//t[@t-if='day.month == start.month and slots.get(day)']" position="attributes">
			<attribute name="t-if">day in month_days and slots.get(day)</attribute>
		</xpath>
		<xpath expr="//button[@t-out='day.day']" position="attributes">
			<attribute name="t-out">day_label(day)</attribute>
		</xpath>
		<xpath expr="//t[@t-else='']/t[@t-out='day.day']" position="attributes">
			<attribute name="t-out">day_label(day)</attribute>
		</xpath>
		<xpath expr="//strong[@t-out='slot.strftime(date_format)']" position="attributes">
			<attribute name="t-out">format_day(slot)</attribute>
		</xpath>
	</template>
</odoo>
