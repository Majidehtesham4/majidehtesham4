<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<!-- To the gateway's page, where the customer pays: Zarinpal and Zibal by its address, the banks' gateways by a
	form posted with their token -->
	<template id="redirect_form">
		<form t-att-action="api_url" t-att-method="method or 'get'">
			<t t-foreach="(inputs or {}).items()" t-as="item">
				<input type="hidden" t-att-name="item[0]" t-att-value="item[1]"/>
			</t>
		</form>
	</template>
</odoo>
