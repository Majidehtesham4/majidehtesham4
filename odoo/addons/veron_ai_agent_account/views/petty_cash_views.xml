<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<!-- Receipts -->
	<record id="receipt_view_form" model="ir.ui.view">
		<field name="name">veron.petty.cash.receipt.form</field>
		<field name="model">veron.petty.cash.receipt</field>
		<field name="arch" type="xml">
			<form>
				<header>
					<button name="action_confirm" type="object" string="Confirm" class="btn-primary"
						invisible="state not in ('new', 'extracted') or closing_state not in ('draft', 'review')"/>
					<button name="action_accept" type="object" string="Accept" class="btn-primary" groups="account.group_account_user"
						invisible="state not in ('confirmed', 'review') or closing_state != 'review'"/>
					<button name="action_reject" type="object" string="Do Not Accept" groups="account.group_account_user"
						invisible="state not in ('confirmed', 'review', 'accepted') or closing_state != 'review'"/>
					<button name="action_check" type="object" string="Check Again" groups="account.group_account_user"
						invisible="state in ('new', 'extracted') or closing_state != 'review'"/>
					<button name="action_open_file" type="object" string="Open the File" invisible="not source_id"/>
					<field name="state" widget="statusbar" statusbar_visible="new,extracted,confirmed,accepted"/>
				</header>
				<sheet>
					<div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
					<div class="alert alert-warning" role="alert" invisible="not open_issue_count">
						<field name="issue_ids" readonly="1" nolabel="1">
							<list create="false" delete="false" decoration-danger="severity == 'critical'" decoration-muted="resolved">
								<field name="kind"/>
								<field name="message"/>
								<field name="other_receipt_id"/>
								<field name="severity" optional="hide"/>
								<field name="resolved" optional="hide"/>
							</list>
						</field>
					</div>
					<group>
						<group>
							<field name="closing_id" readonly="id" options="{'no_create': True}"/>
							<field name="upload" filename="upload_name" invisible="closing_state not in ('draft', 'review')"/>
							<field name="upload_name" invisible="1"/>
							<field name="source_id" readonly="1" invisible="not source_id"/>
							<field name="date"/>
							<field name="vendor_name"/>
							<field name="partner_id" options="{'no_create': True}"/>
							<field name="vendor_tax_id"/>
							<field name="receipt_number"/>
						</group>
						<group>
							<field name="amount"/>
							<field name="vat_amount"/>
							<field name="category_id" options="{'no_create': True}"/>
							<field name="account_id" groups="account.group_account_user" options="{'no_create': True}"/>
							<field name="description"/>
							<field name="confidence" invisible="not confidence"/>
							<field name="confirmed_by" invisible="not confirmed_by"/>
							<field name="decided_by" invisible="not decided_by"/>
							<field name="decision_note" groups="account.group_account_user"/>
							<field name="currency_id" invisible="1"/>
							<field name="closing_state" invisible="1"/>
							<field name="open_issue_count" invisible="1"/>
						</group>
					</group>
					<group string="Read from the File" invisible="not extracted_json">
						<field name="extracted_json" nolabel="1" colspan="2"/>
					</group>
					<p class="text-muted small">Read by an AI agent: compare the fields with the file before confirming.
						Accepted in the AI review is not an accounting approval.</p>
				</sheet>
				<chatter/>
			</form>
		</field>
	</record>

	<record id="receipt_view_list" model="ir.ui.view">
		<field name="name">veron.petty.cash.receipt.list</field>
		<field name="model">veron.petty.cash.receipt</field>
		<field name="arch" type="xml">
			<list decoration-warning="state == 'review'" decoration-muted="state == 'rejected'" decoration-success="state == 'accepted'">
				<field name="name"/>
				<field name="closing_id" optional="hide"/>
				<field name="date"/>
				<field name="vendor_name"/>
				<field name="receipt_number" optional="show"/>
				<field name="category_id" optional="show"/>
				<field name="amount" sum="Total"/>
				<field name="open_issue_count" string="Findings" optional="show"/>
				<field name="state" widget="badge" decoration-success="state == 'accepted'" decoration-warning="state == 'review'"
					decoration-info="state in ('new', 'extracted')"/>
				<field name="currency_id" column_invisible="1"/>
			</list>
		</field>
	</record>

	<!-- Closings -->
	<record id="closing_view_form" model="ir.ui.view">
		<field name="name">veron.petty.cash.closing.form</field>
		<field name="model">veron.petty.cash.closing</field>
		<field name="arch" type="xml">
			<form>
				<header>
					<button name="action_request_documents" type="object" string="Ask for the Documents" groups="account.group_account_user"
						invisible="state != 'draft'"/>
					<button name="action_submit" type="object" string="Documents Given" class="btn-primary" invisible="state != 'draft'"/>
					<button name="action_review" type="object" string="Check the Receipts" class="btn-primary" groups="account.group_account_user"
						invisible="state != 'review'"/>
					<button name="action_draft_move" type="object" string="Make the Draft Entry" groups="account.group_account_user"
						invisible="state not in ('review', 'to_approve')"/>
					<button name="action_post" type="object" string="Post the Entry" class="btn-primary" groups="account.group_account_user"
						invisible="state != 'to_approve'" confirm="The entry is posted with your rights. Continue?"/>
					<button name="action_print" type="object" string="Settlement Report"/>
					<button name="action_cancel" type="object" string="Cancel" groups="account.group_account_user"
						invisible="state in ('posted', 'cancelled')"/>
					<field name="state" widget="statusbar" statusbar_visible="draft,review,to_approve,posted"/>
				</header>
				<sheet>
					<div class="oe_button_box" name="button_box">
						<button name="action_open_move" type="object" class="oe_stat_button" icon="fa-book" invisible="not move_id">
							<field name="move_state" widget="statinfo" string="Entry"/>
						</button>
					</div>
					<div class="oe_title"><h1><field name="name" readonly="1"/></h1><field name="period"/></div>
					<group>
						<group>
							<field name="fund_id" readonly="id" options="{'no_create': True}"/>
							<field name="custodian_user_id"/>
							<field name="date_from" readonly="state != 'draft'"/>
							<field name="date_to" readonly="state != 'draft'"/>
							<field name="requested_at" invisible="not requested_at"/>
							<field name="submitted_at" invisible="not submitted_at"/>
							<field name="posted_by" invisible="not posted_by"/>
						</group>
						<group string="Settlement">
							<field name="opening_balance"/>
							<field name="topup_amount"/>
							<field name="submitted_amount"/>
							<field name="accepted_amount"/>
							<field name="rejected_amount"/>
							<field name="review_amount"/>
							<field name="closing_balance" class="fw-bold"/>
							<field name="currency_id" invisible="1"/>
						</group>
					</group>
					<notebook>
						<page string="Receipts" name="receipts">
							<field name="receipt_ids" context="{'default_closing_id': id}" readonly="state not in ('draft', 'review')"/>
						</page>
						<page string="Notes" name="notes">
							<field name="note"/>
						</page>
					</notebook>
				</sheet>
				<chatter/>
			</form>
		</field>
	</record>

	<record id="closing_view_list" model="ir.ui.view">
		<field name="name">veron.petty.cash.closing.list</field>
		<field name="model">veron.petty.cash.closing</field>
		<field name="arch" type="xml">
			<list>
				<field name="name"/>
				<field name="fund_id"/>
				<field name="custodian_user_id"/>
				<field name="period"/>
				<field name="receipt_count" string="Receipts"/>
				<field name="accepted_amount"/>
				<field name="closing_balance"/>
				<field name="state" widget="badge" decoration-success="state == 'posted'" decoration-warning="state == 'to_approve'"
					decoration-info="state in ('draft', 'review')"/>
				<field name="currency_id" column_invisible="1"/>
			</list>
		</field>
	</record>

	<record id="closing_view_search" model="ir.ui.view">
		<field name="name">veron.petty.cash.closing.search</field>
		<field name="model">veron.petty.cash.closing</field>
		<field name="arch" type="xml">
			<search>
				<field name="name"/>
				<field name="fund_id"/>
				<field name="custodian_user_id"/>
				<filter name="open" string="Open" domain="[('state', 'in', ('draft', 'review', 'to_approve'))]"/>
				<filter name="mine" string="My Funds" domain="[('custodian_user_id', '=', uid)]"/>
				<group>
					<filter name="by_fund" string="Fund" context="{'group_by': 'fund_id'}"/>
					<filter name="by_state" string="State" context="{'group_by': 'state'}"/>
				</group>
			</search>
		</field>
	</record>

	<!-- Funds and expense types -->
	<record id="fund_view_form" model="ir.ui.view">
		<field name="name">veron.petty.cash.fund.form</field>
		<field name="model">veron.petty.cash.fund</field>
		<field name="arch" type="xml">
			<form>
				<sheet>
					<div class="oe_title"><h1><field name="name" placeholder="e.g. Petty cash of the showroom"/></h1></div>
					<group>
						<group>
							<field name="custodian_user_id" options="{'no_create': True}"/>
							<field name="account_id" options="{'no_create': True}"/>
							<field name="journal_id" options="{'no_create': True}"/>
							<field name="amount"/>
							<field name="balance"/>
							<field name="company_id" groups="base.group_multi_company"/>
							<field name="active" invisible="1"/>
							<field name="currency_id" invisible="1"/>
						</group>
						<group string="Policy">
							<field name="max_receipt_amount"/>
							<field name="max_receipt_age_days"/>
							<field name="tax_id_required_above"/>
							<field name="vat_account_id" options="{'no_create': True}"/>
							<field name="similar_distance"/>
						</group>
					</group>
					<field name="category_ids" widget="many2many_tags" placeholder="Allowed expense types; empty: all"/>
					<field name="closing_ids" readonly="1">
						<list>
							<field name="name"/>
							<field name="period"/>
							<field name="accepted_amount"/>
							<field name="state"/>
							<field name="currency_id" column_invisible="1"/>
						</list>
					</field>
				</sheet>
				<chatter/>
			</form>
		</field>
	</record>

	<record id="fund_view_list" model="ir.ui.view">
		<field name="name">veron.petty.cash.fund.list</field>
		<field name="model">veron.petty.cash.fund</field>
		<field name="arch" type="xml">
			<list>
				<field name="name"/>
				<field name="custodian_user_id"/>
				<field name="account_id"/>
				<field name="amount"/>
				<field name="balance"/>
				<field name="currency_id" column_invisible="1"/>
			</list>
		</field>
	</record>

	<record id="category_view_list" model="ir.ui.view">
		<field name="name">veron.petty.cash.category.list</field>
		<field name="model">veron.petty.cash.category</field>
		<field name="arch" type="xml">
			<list editable="bottom">
				<field name="sequence" widget="handle"/>
				<field name="name"/>
				<field name="account_id" options="{'no_create': True}"/>
				<field name="max_amount"/>
				<field name="needs_tax_id"/>
				<field name="note" optional="show"/>
				<field name="company_id" groups="base.group_multi_company"/>
				<field name="currency_id" column_invisible="1"/>
			</list>
		</field>
	</record>

	<record id="action_closings" model="ir.actions.act_window">
		<field name="name">Petty Cash Closings</field>
		<field name="res_model">veron.petty.cash.closing</field>
		<field name="view_mode">list,form</field>
		<field name="context">{'search_default_open': 1}</field>
		<field name="help" type="html">
			<p class="o_view_nocontent_smiling_face">No petty cash closing</p>
			<p>At the end of a period the custodian gives the receipts here: a photo or a PDF of each, checked when it is
				added. An agent can read them, check them for duplicates and against the fund's policy, and make the draft entry;
				an accountant reviews and posts it.</p>
		</field>
	</record>
	<record id="action_receipts" model="ir.actions.act_window">
		<field name="name">Petty Cash Receipts</field>
		<field name="res_model">veron.petty.cash.receipt</field>
		<field name="view_mode">list,form</field>
	</record>
	<record id="action_funds" model="ir.actions.act_window">
		<field name="name">Petty Cash Funds</field>
		<field name="res_model">veron.petty.cash.fund</field>
		<field name="view_mode">list,form</field>
	</record>
	<record id="action_categories" model="ir.actions.act_window">
		<field name="name">Petty Cash Expense Types</field>
		<field name="res_model">veron.petty.cash.category</field>
		<field name="view_mode">list</field>
	</record>

	<menuitem id="menu_root" name="Petty Cash" web_icon="veron_ai_agent_account,static/description/icon.png" sequence="45"
		groups="group_petty_cash_custodian,account.group_account_user"/>
	<menuitem id="menu_closings" name="Closings" parent="menu_root" action="action_closings" sequence="1"/>
	<menuitem id="menu_receipts" name="Receipts" parent="menu_root" action="action_receipts" sequence="2"/>
	<menuitem id="menu_config" name="Settings" parent="menu_root" sequence="90" groups="account.group_account_user">
		<menuitem id="menu_funds" name="Funds" action="action_funds" sequence="1"/>
		<menuitem id="menu_categories" name="Expense Types" action="action_categories" sequence="2"
			groups="account.group_account_manager"/>
	</menuitem>
</odoo>
