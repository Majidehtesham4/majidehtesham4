<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<!-- Phrases added to the library after it was installed; read on every update, without removing a manager's own -->
	<function model="veron.ai.intent" name="_add_phrases">
		<value>bill_from_document</value>
		<value eval="['این فاکتور را پیش نویس کن', 'از روی این عکس فاکتور بساز', 'پیش نویس فاکتور خرید از این عکس',
			'این را ثبت کن', 'این قبض خرید را وارد کن', 'اطلاعات این فاکتور را ثبت کن']"/>
		<value eval="['ثبت فاکتور خرید از روی فایل', 'ثبت فاکتور از روی فایل']"/>
	</function>
	<function model="veron.ai.intent" name="_add_phrases">
		<value>sale_invoice_draft</value>
		<value eval="['فاکتور کن', 'فاکتور بزن برای', 'فاکتور بنویس برای', 'برایش فاکتور کن', 'فاکتور فروش بنویس']"/>
	</function>
	<!-- The draft invoices offered to choose from, rather than asking for a number -->
	<function model="veron.ai.intent" name="_update_slot">
		<value>invoice_post</value>
		<value>move_id</value>
		<value eval="{'recent': [['state', '=', 'draft'], ['move_type', 'in', ['out_invoice', 'in_invoice', 'out_refund', 'in_refund']]]}"/>
	</function>
	<!-- An invoice's customer is one who buys, its product one that is sold -->
	<function model="veron.ai.intent" name="_update_slot">
		<value>sale_invoice_draft</value>
		<value>partner_id</value>
		<value eval="{'prefer': [['customer_rank', '>', 0]]}"/>
	</function>
	<function model="veron.ai.intent" name="_update_slot">
		<value>sale_invoice_draft</value>
		<value>product_id</value>
		<value eval="{'prefer': [['sale_ok', '=', True]]}"/>
	</function>
	<!-- The draft just made is the one posted -->
	<function model="veron.ai.intent" name="_update_slot">
		<value>invoice_post</value>
		<value>move_id</value>
		<value eval="{'remembered': True}"/>
	</function>
	<!-- A product named while changing a draft is one of its lines -->
	<function model="veron.ai.intent" name="_update_slot">
		<value>invoice_draft_discount</value>
		<value>product_id</value>
		<value eval="{'within': {'of': 'move_id', 'path': 'invoice_line_ids.product_id'}}"/>
	</function>
	<function model="veron.ai.intent" name="_update_slot">
		<value>invoice_draft_quantity</value>
		<value>product_id</value>
		<value eval="{'within': {'of': 'move_id', 'path': 'invoice_line_ids.product_id'}}"/>
	</function>
	<function model="veron.ai.intent" name="_update_slot">
		<value>invoice_draft_price</value>
		<value>product_id</value>
		<value eval="{'within': {'of': 'move_id', 'path': 'invoice_line_ids.product_id'}}"/>
	</function>
	<function model="veron.ai.intent" name="_update_slot">
		<value>invoice_draft_remove</value>
		<value>product_id</value>
		<value eval="{'within': {'of': 'move_id', 'path': 'invoice_line_ids.product_id'}}"/>
	</function>
	<!-- Taxes are never added or taken off silently: said, set in the AI settings, or asked -->
	<function model="veron.ai.intent" name="_ensure_slot">
		<value>sale_invoice_draft</value>
		<value eval='{"arg": "taxes", "choices": [["product", "بله، مالیات طبق تنظیم کالاها"], ["none", "خیر، بدون مالیات"]], "detect": {"بدون مالیات": "none", "بدون ارزش افزوده": "none", "مالیات نزن": "none", "بی مالیات": "none", "با مالیات": "product", "با ارزش افزوده": "product", "مالیات دار": "product", "مالیات بزن": "product"}, "answers": {"بله": "product", "اره": "product", "اری": "product", "اعمال شود": "product", "خیر": "none", "نه": "none", "نخیر": "none"}, "param": "veron_ai_agent_account.invoice_taxes", "question": "مالیات اعمال شود؟", "required": True}'/>
		<value>$taxes</value>
	</function>
</odoo>
