<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="voucher_template_view_list" model="ir.ui.view">
		<field name="name">veron.voucher.template.list</field>
		<field name="model">veron.voucher.template</field>
		<field name="arch" type="xml">
			<list>
				<field name="name"/>
				<field name="journal_id"/>
				<field name="company_id" groups="base.group_multi_company"/>
			</list>
		</field>
	</record>
	<record id="voucher_template_view_form" model="ir.ui.view">
		<field name="name">veron.voucher.template.form</field>
		<field name="model">veron.voucher.template</field>
		<field name="arch" type="xml">
			<form>
				<sheet>
					<group>
						<group><field name="name"/><field name="label"/></group>
						<group><field name="journal_id"/><field name="company_id" groups="base.group_multi_company"/><field name="active" invisible="1"/></group>
					</group>
					<div class="text-muted mb-2">The shares of the debit lines add up to 100%, and those of the credit lines too.</div>
					<field name="line_ids">
						<list editable="bottom">
							<field name="sequence" widget="handle"/>
							<field name="side"/>
							<field name="account_id"/>
							<field name="partner_id"/>
							<field name="share"/>
							<field name="label"/>
						</list>
					</field>
				</sheet>
			</form>
		</field>
	</record>
	<record id="action_voucher_templates" model="ir.actions.act_window">
		<field name="name">Voucher Templates</field>
		<field name="res_model">veron.voucher.template</field>
		<field name="view_mode">list,form</field>
	</record>
</odoo>
