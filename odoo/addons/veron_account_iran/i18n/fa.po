#. module: veron_account_iran
#: model_terms:ir.ui.view,arch_db:veron_account_iran.aggregate_view_form
msgid ""
"The draft entries chosen become one draft voucher, their lines summed by "
"account; the drafts are removed. Posted entries and invoices are not merged."
msgstr ""
"اسناد پیش‌نویس انتخاب‌شده یک سند پیش‌نویس می‌شوند و سطرهایشان به تفکیک حساب "
"جمع می‌شود؛ پیش‌نویس‌ها حذف می‌شوند. اسناد قطعی و فاکتورها ادغام نمی‌شوند."

#. module: veron_account_iran
#. odoo-python
#: code:addons/veron_account_iran/wizard/aggregate.py:0
msgid "The entries are of different companies."
msgstr "اسناد مربوط به شرکت‌های مختلف‌اند."

#. module: veron_account_iran
#: model:ir.model.fields,help:veron_account_iran.field_account_bank_statement_line__veron_aggregated_from
#: model:ir.model.fields,help:veron_account_iran.field_account_move__veron_aggregated_from
