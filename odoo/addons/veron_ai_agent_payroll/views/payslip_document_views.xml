<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="document_view_list" model="ir.ui.view">
		<field name="name">veron.payslip.document.list</field>
		<field name="model">veron.payslip.document</field>
		<field name="arch" type="xml">
			<list create="false" delete="false">
				<field name="month"/>
				<field name="employee_id"/>
				<field name="name"/>
				<field name="prepared_at"/>
				<button name="action_download" type="object" string="Download" icon="fa-download"/>
			</list>
		</field>
	</record>

	<record id="action_my_payslips" model="ir.actions.act_window">
		<field name="name">My Payslips</field>
		<field name="res_model">veron.payslip.document</field>
		<field name="view_mode">list</field>
		<field name="help" type="html">
			<p class="o_view_nocontent_smiling_face">No payslip yet</p>
			<p>The PDF of each of your payslips appears here once payroll prepares it. Only you and payroll managers see it.</p>
		</field>
	</record>

	<menuitem id="menu_my_payslips" name="My Payslips" parent="hr.menu_hr_root" action="action_my_payslips" sequence="95"
		groups="base.group_user"/>
</odoo>
