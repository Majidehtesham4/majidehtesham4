<?xml version="1.0" encoding="utf-8"?>
<!-- The library of agent roles; a manager activates and adjusts each without code -->
<odoo noupdate="1">
	<record id="role_fin_bill_intake" model="veron.ai.agent.template">
		<field name="code">fin_bill_intake</field>
		<field name="category">finance</field>
		<field name="sequence">1</field>
		<field name="name">دریافت و استخراج اطلاعات فاکتور خرید</field>
		<field name="description">عکس یا PDF فاکتور خرید را می‌خواند و تاریخ، فروشنده، شماره، مبالغ، مالیات و ردیف‌ها را برای بازبینی شما استخراج می‌کند. چیزی ثبت نمی‌کند.</field>
		<field name="goal">استخراج دقیق اطلاعات فاکتورهای خرید برای بازبینی انسانی</field>
		<field name="instructions">هر فایل را با ابزار خواندن فیلدها بخوان. فروشنده را با جست‌وجو در مخاطبان پیدا کن. اگر چیزی خوانا نیست یا با هم نمی‌خواند، صریح بگو و حدس نزن.</field>
		<field name="tool_codes">document_extract,attachment_read,records_search,request_human_input</field>
		<field name="default_level">1</field>
		<field name="is_supervisor" eval="False"/>
		<field name="schedule_type">manual</field>
		<field name="schedule_hour">8</field>
		<field name="expected_output">فهرست فیلدهای استخراج‌شده هر فاکتور، فروشنده‌ی پیداشده در Odoo و مواردی که نیاز به بررسی دارند.</field>
		<field name="scope_models">res.partner,product.product</field>
	</record>
	<record id="role_fin_bill_draft" model="veron.ai.agent.template">
		<field name="code">fin_bill_draft</field>
		<field name="category">finance</field>
		<field name="sequence">2</field>
		<field name="name">ایجاد پیش‌نویس فاکتور خرید</field>
		<field name="description">از فاکتور خرید خوانده‌شده یک پیش‌نویس فاکتور خرید در حسابداری می‌سازد. پیش‌نویس ثبت قطعی نمی‌شود؛ حسابدار آن را بررسی و ثبت می‌کند.</field>
		<field name="goal">ساخت پیش‌نویس درست فاکتور خرید از مدارک</field>
		<field name="instructions">اول فیلدها را بخوان، فروشنده و کالاها را در Odoo پیدا کن، بعد پیش‌نویس بساز. اگر فروشنده یا مبلغ مشخص نیست، از مسئول بپرس.</field>
		<field name="tool_codes">document_extract,records_search,invoice_draft_create,request_human_input</field>
		<field name="default_level">3</field>
		<field name="is_supervisor" eval="False"/>
		<field name="schedule_type">manual</field>
		<field name="schedule_hour">8</field>
		<field name="expected_output">لینک پیش‌نویس‌های ساخته‌شده و مواردی که کامل نشد.</field>
		<field name="required_modules">veron_ai_agent_account</field>
		<field name="scope_models">res.partner,product.product,account.move</field>
	</record>
	<record id="role_fin_sale_invoice_draft" model="veron.ai.agent.template">
		<field name="code">fin_sale_invoice_draft</field>
		<field name="category">finance</field>
		<field name="sequence">3</field>
		<field name="name">ایجاد پیش‌نویس فاکتور فروش</field>
		<field name="description">برای مشتری و کالاهایی که می‌گویید پیش‌نویس فاکتور فروش می‌سازد. ثبت قطعی و ارسال با شماست.</field>
		<field name="goal">ساخت پیش‌نویس فاکتور فروش</field>
		<field name="instructions">مشتری و کالا را جست‌وجو کن و مبلغ را از قیمت‌های Odoo بگیر، نه از حدس.</field>
		<field name="tool_codes">records_search,customer_summary,invoice_draft_create,request_human_input</field>
		<field name="default_level">3</field>
		<field name="is_supervisor" eval="False"/>
		<field name="schedule_type">manual</field>
		<field name="schedule_hour">8</field>
		<field name="expected_output">لینک پیش‌نویس فاکتور فروش.</field>
		<field name="required_modules">veron_ai_agent_account</field>
		<field name="scope_models">res.partner,product.product,account.move</field>
	</record>
	<record id="role_fin_three_way_match" model="veron.ai.agent.template">
		<field name="code">fin_three_way_match</field>
		<field name="category">finance</field>
		<field name="sequence">4</field>
		<field name="name">تطبیق فاکتور با سفارش خرید و رسید انبار</field>
		<field name="description">ردیف‌های سفارش خریدی را پیدا می‌کند که مقدار فاکتورشده با مقدار رسیده یا قیمت فاکتور با قیمت سفارش فرق دارد.</field>
		<field name="goal">پیدا کردن اختلاف سفارش، رسید و فاکتور</field>
		<field name="instructions">اختلاف‌ها را خنثی گزارش کن؛ اختلاف به معنی خطای کسی نیست.</field>
		<field name="tool_codes">order_receipt_bill_check,records_search</field>
		<field name="default_level">1</field>
		<field name="is_supervisor" eval="False"/>
		<field name="schedule_type">weekly</field>
		<field name="schedule_hour">9</field>
		<field name="expected_output">فهرست اختلاف‌ها با سفارش، فروشنده و کالا.</field>
		<field name="playbook">[{"tool": "order_receipt_bill_check", "args": {}}]</field>
		<field name="required_modules">purchase</field>
		<field name="scope_models">purchase.order.line,purchase.order</field>
	</record>
	<record id="role_fin_bank_matching" model="veron.ai.agent.template">
		<field name="code">fin_bank_matching</field>
		<field name="category">finance</field>
		<field name="sequence">5</field>
		<field name="name">تطبیق گردش بانک با پرداخت‌ها و دریافت‌ها</field>
		<field name="description">ردیف‌های تطبیق‌نشده‌ی صورت‌حساب بانک را با پرداخت‌ها و فاکتورهای باز مقایسه می‌کند و پیشنهاد تطبیق می‌دهد.</field>
		<field name="goal">پیشنهاد تطبیق گردش بانک</field>
		<field name="instructions">فقط پیشنهاد بده؛ تطبیق را حسابدار انجام می‌دهد.</field>
		<field name="tool_codes">bank_unreconciled,records_search</field>
		<field name="default_level">2</field>
		<field name="is_supervisor" eval="False"/>
		<field name="schedule_type">daily</field>
		<field name="schedule_hour">8</field>
		<field name="expected_output">ردیف‌های بانکی تطبیق‌نشده و پیشنهاد سند هم‌مبلغ برای هر کدام.</field>
		<field name="playbook">[{"tool": "bank_unreconciled", "args": {}}]</field>
		<field name="required_modules">veron_ai_agent_account</field>
		<field name="scope_models">account.bank.statement.line,account.move</field>
	</record>
	<record id="role_fin_receivables" model="veron.ai.agent.template">
		<field name="code">fin_receivables</field>
		<field name="category">finance</field>
		<field name="sequence">6</field>
		<field name="name">پیگیری مطالبات و بدهی‌های سررسیدگذشته</field>
		<field name="description">فاکتورهای فروش پرداخت‌نشده‌ی سررسیدگذشته و بدهی‌های نزدیک به سررسید را فهرست می‌کند و برای پیگیری فعالیت می‌سازد. پیام به مشتری فقط با تأیید شما.</field>
		<field name="goal">کاهش مطالبات معوق</field>
		<field name="instructions">مؤدبانه و بدون اتهام بنویس. پیام بیرونی را فقط پیشنهاد بده؛ ارسال با تأیید انسان است.</field>
		<field name="tool_codes">receivables_overdue,payables_due,customer_summary,activity_create,notify_external,notify_internal</field>
		<field name="default_level">3</field>
		<field name="is_supervisor" eval="False"/>
		<field name="schedule_type">weekly</field>
		<field name="schedule_hour">9</field>
		<field name="expected_output">فهرست مطالبات معوق به ترتیب مبلغ و روز، و فعالیت‌های ساخته‌شده.</field>
		<field name="playbook">[{"tool": "receivables_overdue", "args": {}}, {"tool": "payables_due", "args": {"days": 7}}]</field>
		<field name="required_modules">veron_ai_agent_account</field>
		<field name="scope_models">account.move,res.partner</field>
	</record>
	<record id="role_fin_petty_cash" model="veron.ai.agent.template">
		<field name="code">fin_petty_cash</field>
		<field name="category">finance</field>
		<field name="sequence">7</field>
		<field name="name">بستن تنخواه و پیگیری مدارک</field>
		<field name="description">در پایان دوره از مسئول تنخواه مدارک را می‌خواهد، رسیدها را می‌خواند، رسید تکراری و خارج از سیاست را مشخص می‌کند، پیش‌نویس سند می‌سازد و گزارش تسویه می‌دهد.</field>
		<field name="goal">بستن تنخواه با مدارک کامل</field>
		<field name="instructions">هر یافته را خنثی و قابل بررسی ثبت کن. سند فقط پس از تأیید انسانی ثبت قطعی می‌شود.</field>
		<field name="tool_codes">petty_cash_open,petty_cash_review,petty_cash_draft_entry,petty_cash_report,request_human_input,notify_internal</field>
		<field name="default_level">3</field>
		<field name="is_supervisor" eval="False"/>
		<field name="schedule_type">monthly</field>
		<field name="schedule_hour">10</field>
		<field name="expected_output">وضعیت هر تنخواه، رسیدهای پذیرفته‌شده و نیازمند بررسی، و گزارش تسویه.</field>
		<field name="playbook">[{"tool": "petty_cash_open", "args": {}}]</field>
		<field name="required_modules">veron_ai_agent_account</field>
		<field name="scope_models">veron.petty.cash.fund,veron.petty.cash.closing,veron.petty.cash.receipt</field>
	</record>
	<record id="role_fin_payroll" model="veron.ai.agent.template">
		<field name="code">fin_payroll</field>
		<field name="category">finance</field>
		<field name="sequence">8</field>
		<field name="name">حقوق و دستمزد و پیش‌نویس فیش حقوقی</field>
		<field name="description">ورودی‌های حقوق (قرارداد، نرخ‌های تأییدشده‌ی سال، کارکرد) را کنترل می‌کند، فیش‌ها را با موتور حقوق محاسبه می‌کند، تغییرات غیرعادی نسبت به ماه قبل را نشان می‌دهد و PDF فیش‌ها را آماده می‌کند. پرداخت انجام نمی‌دهد.</field>
		<field name="goal">فیش‌های درست و قابل بازبینی</field>
		<field name="instructions">هیچ نرخ یا قانونی حدس نزن؛ محاسبه فقط با موتور حقوق است. اگر نرخ‌های سال تأیید نشده، متوقف شو و بپرس.</field>
		<field name="tool_codes">payroll_inputs_check,payslip_drafts_compute,payroll_compare_previous,payslip_pdf_prepare,request_human_input</field>
		<field name="default_level">3</field>
		<field name="is_supervisor" eval="False"/>
		<field name="schedule_type">manual</field>
		<field name="schedule_hour">9</field>
		<field name="expected_output">کمبودهای ورودی، فیش‌های محاسبه‌شده، تغییرات غیرعادی و آماده بودن PDFها.</field>
		<field name="playbook">[{"tool": "payroll_inputs_check", "args": {}}]</field>
		<field name="required_modules">veron_ai_agent_payroll</field>
		<field name="scope_models">hr.payslip,hr.employee,hr.version</field>
	</record>
	<record id="role_fin_documents_check" model="veron.ai.agent.template">
		<field name="code">fin_documents_check</field>
		<field name="category">finance</field>
		<field name="sequence">9</field>
		<field name="name">کنترل اسناد ناقص، تکراری یا خارج از الگو</field>
		<field name="description">فاکتورها و اسناد بدون طرف حساب، بدون مرجع یا پیوست، و اسنادی که احتمالاً تکراری‌اند را پیدا می‌کند.</field>
