<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="sequence_run" model="ir.sequence">
		<field name="name">Agent Run</field>
		<field name="code">veron.ai.run</field>
		<field name="prefix">RUN-</field>
		<field name="padding">6</field>
		<field name="company_id" eval="False"/>
	</record>
	<record id="sequence_approval" model="ir.sequence">
		<field name="name">Agent Approval</field>
		<field name="code">veron.ai.approval</field>
		<field name="prefix">APR-</field>
		<field name="padding">6</field>
		<field name="company_id" eval="False"/>
	</record>
	<record id="cron_schedules" model="ir.cron">
		<field name="name">AI Agents: scheduled and queued runs</field>
		<field name="model_id" ref="model_veron_ai_schedule"/>
		<field name="state">code</field>
		<field name="code">model._cron_due()</field>
		<field name="interval_number">5</field>
		<field name="interval_type">minutes</field>
	</record>
	<record id="cron_cleanup" model="ir.cron">
		<field name="name">AI Agents: files past their keeping date</field>
		<field name="model_id" ref="model_veron_ai_source"/>
		<field name="state">code</field>
		<field name="code">model._cron_cleanup()</field>
		<field name="interval_number">1</field>
		<field name="interval_type">days</field>
	</record>
	<function model="veron.ai.tool" name="_sync"/>

	<!-- The assistant of the chat box on every page; a manager's changes to it are kept -->
	<data noupdate="1">
	<record id="agent_assistant" model="veron.ai.agent">
		<field name="name">دستیار</field>
		<field name="enabled" eval="True"/>
		<field name="all_users" eval="True"/>
		<field name="engine">auto</field>
		<field name="authority_level">3</field>
		<field name="company_id" ref="base.main_company"/>
		<field name="company_ids" eval="[(6, 0, [ref('base.main_company')])]"/>
		<field name="responsible_user_id" ref="base.user_admin"/>
		<field name="goal">به هر کاربر با دسترسی خود او کمک می‌کند: گزارش می‌دهد، جست‌وجو می‌کند، فایل می‌خواند و پیش‌نویس می‌سازد.</field>
		<field name="instructions">با همان دسترسی کاربری که می‌پرسد کار کن. اقدام حساس منتظر تأیید می‌ماند. عدد را فقط از ابزارها بیاور.</field>
		<field name="description">دستیار برنامه در همه‌ی صفحه‌ها</field>
	</record>
	</data>
	<function model="veron.ai.agent" name="_setup_assistant"/>

	<!-- The program's own bot, shown as the author of what the system does, carries no platform name -->
	<function model="res.partner" name="write" eval="[[ref('base.partner_root')], {'name': 'ربات برنامه'}]"/>
</odoo>
