<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="team_wizard_view_form" model="ir.ui.view">
		<field name="name">veron.ai.team.wizard.form</field>
		<field name="model">veron.ai.team.wizard</field>
		<field name="arch" type="xml">
			<form>
				<p class="text-muted">
					A supervisor does no task itself: it gives each one to the part of its team that has the tool for it,
					checks the result and brings to you what looks wrong. Pick the supervisor, add or take away the parts,
					read what each may do, then make the team.
				</p>
				<group>
					<group>
						<field name="supervisor_template_id" options="{'no_create': True}"/>
						<field name="name"/>
						<field name="authority_level"/>
						<field name="enable"/>
					</group>
					<group>
						<field name="responsible_user_id"/>
						<field name="supervisor_user_id"/>
						<field name="company_ids" widget="many2many_tags" groups="base.group_multi_company"/>
					</group>
				</group>
				<group string="Parts of the Team">
					<field name="member_template_ids" nolabel="1" colspan="2" widget="many2many_tags"
						options="{'no_create': True}" placeholder="Add a part: a role of the library..."/>
				</group>
				<group string="What Each Part May Read and Do">
					<field name="explanation" nolabel="1" colspan="2"/>
				</group>
				<field name="understood"/> <label for="understood"/>
				<footer>
					<button name="action_create" type="object" string="Make the Team" class="btn-primary"/>
					<button string="Cancel" special="cancel" class="btn-secondary"/>
				</footer>
			</form>
		</field>
	</record>

	<record id="action_team_wizard" model="ir.actions.act_window">
		<field name="name">Build an Agent Team</field>
		<field name="res_model">veron.ai.team.wizard</field>
		<field name="view_mode">form</field>
		<field name="target">new</field>
	</record>

	<menuitem id="menu_team_wizard" name="Build a Team" parent="menu_agents" action="action_team_wizard" sequence="3"
		groups="group_ai_manager"/>
</odoo>
