#. module: account_statement_import_file
#: model_terms:ir.ui.view,arch_db:account_statement_import_file.journal_dashboard_view_inherit
msgid "<span>Import (OCA)</span>"
msgstr "<span>ورود صورت‌حساب</span>"

#. module: account_statement_import_file
#. odoo-python
#: code:addons/account_statement_import_file/wizard/account_statement_import.py:0
msgid ""
"Could not find any bank account with number '%(account_number)s'  linked to "
"partner '%(partner_name)s'. You should create the bank account and set it on"
" the related bank journal. If the related bank journal doesn't exist yet, "
"you should create a new one."
msgstr ""
"هیچ حساب بانکی با شماره‌ی «%(account_number)s» مربوط به «%(partner_name)s» "
"پیدا نشد. حساب بانکی را بسازید و آن را روی دفتر بانک مربوط تنظیم کنید. اگر "
"آن دفتر بانک هنوز وجود ندارد، یک دفتر تازه بسازید."

#. module: account_statement_import_file
#: model:ir.model.fields,help:account_statement_import_file.field_account_statement_import__statement_file
msgid "Download bank statement files from your bank and upload them here."
msgstr "فایل صورت‌حساب را از بانک بگیرید و این‌جا بارگذاری کنید."

#. module: account_statement_import_file
#. odoo-python
#: code:addons/account_statement_import_file/models/account_journal.py:0
msgid "Import (OCA) (%s)"
msgstr "ورود صورت‌حساب (%s)"

#. module: account_statement_import_file
#: model_terms:ir.ui.view,arch_db:account_statement_import_file.journal_dashboard_view_inherit
msgid "Import Statement (OCA)"
msgstr "ورود صورت‌حساب بانکی"

#. module: account_statement_import_file
#: model_terms:ir.ui.view,arch_db:account_statement_import_file.account_statement_import_form
msgid "Import and View"
msgstr "ورود و نمایش"

#. module: account_statement_import_file
#. odoo-python
#: code:addons/account_statement_import_file/wizard/account_statement_import.py:0
msgid "Missing currency code in the bank statement file."
msgstr "کد ارز در فایل صورت‌حساب بانکی نیست."

#. module: account_statement_import_file
#: model_terms:ir.ui.view,arch_db:account_statement_import_file.account_statement_import_form
msgid "Supported formats:"
msgstr "قالب‌های پشتیبانی‌شده:"

#. module: account_statement_import_file
#. odoo-python
#: code:addons/account_statement_import_file/wizard/account_statement_import.py:0
msgid "The Bank Accounting Account is not set on the journal '%s'."
msgstr "حساب معین بانک روی دفتر «%s» تنظیم نشده است."

#. module: account_statement_import_file
#. odoo-python
#: code:addons/account_statement_import_file/wizard/account_statement_import.py:0
msgid ""
"The bank account with number '%(account_number)s' exists in Odoo but it is "
"not set on any bank journal. You should set it on the related bank journal. "
"If the related bank journal doesn't  exist yet, you should create a new one."
msgstr ""
"حساب بانکی با شماره‌ی «%(account_number)s» در سیستم هست ولی روی هیچ دفتر "
"بانکی تنظیم نشده است. آن را روی دفتر بانک مربوط تنظیم کنید. اگر آن دفتر بانک"
" هنوز وجود ندارد، یک دفتر تازه بسازید."

#. module: account_statement_import_file
#. odoo-python
#: code:addons/account_statement_import_file/wizard/account_statement_import.py:0
msgid ""
"The bank statement file uses currency '%s' but there is no such currency in "
"Odoo."
msgstr "فایل صورت‌حساب ارز «%s» دارد ولی این ارز در سیستم نیست."

#. module: account_statement_import_file
#. odoo-python
#: code:addons/account_statement_import_file/wizard/account_statement_import.py:0
msgid ""
"The currency of the bank statement (%(currency_name)s) is not the same as "
"the currency of the journal '%(journal_name)s' (%(journal_currency_name)s)."
msgstr ""
"ارز صورت‌حساب بانکی (%(currency_name)s) با ارز دفتر «%(journal_name)s» "
"(%(journal_currency_name)s) یکی نیست."

#. module: account_statement_import_file
#. odoo-python
#: code:addons/account_statement_import_file/wizard/account_statement_import.py:0
msgid ""
"The format of this bank statement file doesn't contain the bank account "
"number, so you must start the wizard from the right bank journal in the "
"dashboard."
msgstr ""
"این قالب صورت‌حساب شماره‌ی حساب بانکی را ندارد؛ ورود را از دفتر بانک درست در"
" داشبورد شروع کنید."

#. module: account_statement_import_file
#. odoo-python
#: code:addons/account_statement_import_file/wizard/account_statement_import.py:0
msgid ""
"The journal found for the file (%(journal_match)s) is different from the "
"selected journal (%(journal_selected)s)."
msgstr ""
"دفتری که برای فایل پیدا شد (%(journal_match)s) با دفتر انتخاب‌شده "
"(%(journal_selected)s) فرق دارد."

#. module: account_statement_import_file
#. odoo-python
#: code:addons/account_statement_import_file/wizard/account_statement_import.py:0
msgid "The parsing of the statement file returned an invalid result."
msgstr "خواندن فایل صورت‌حساب نتیجه‌ی نامعتبری داد."

#. module: account_statement_import_file
#. odoo-python
#: code:addons/account_statement_import_file/wizard/account_statement_import.py:0
msgid ""
"This bank statement file format is not supported.\n"
"Did you install the Odoo module to support this format?"
msgstr ""
"این قالب فایل صورت‌حساب پشتیبانی نمی‌شود.\n"
"ماژول این قالب نصب شده است؟"

#. module: account_statement_import_file
#. odoo-python
#: code:addons/account_statement_import_file/wizard/account_statement_import.py:0
msgid ""
"You have already imported this file, or this file only contains already "
"imported transactions."
msgstr ""
"این فایل قبلاً وارد شده است، یا فقط تراکنش‌هایی دارد که قبلاً وارد شده‌اند."
