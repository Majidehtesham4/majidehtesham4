<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="rotation_view_list" model="ir.ui.view">
		<field name="name">veron.planning.rotation.list</field>
		<field name="model">veron.planning.rotation</field>
		<field name="arch" type="xml">
			<list>
				<field name="name"/>
				<field name="length"/>
				<field name="company_id" groups="base.group_multi_company"/>
			</list>
		</field>
	</record>
	<record id="rotation_view_form" model="ir.ui.view">
		<field name="name">veron.planning.rotation.form</field>
		<field name="model">veron.planning.rotation</field>
		<field name="arch" type="xml">
			<form>
				<header>
					<button name="%(action_rotation_generate)d" type="action" string="Make the Shifts" class="btn-primary"/>
				</header>
				<sheet>
					<div class="oe_title"><h1><field name="name" placeholder="e.g. Four groups, 24 hours"/></h1></div>
					<group>
						<group><field name="tz"/><field name="length"/></group>
						<group><field name="company_id" groups="base.group_multi_company"/><field name="active" invisible="1"/></group>
					</group>
					<notebook>
						<page string="Days of the Cycle" name="days">
							<field name="day_ids">
								<list editable="bottom">
									<field name="sequence" widget="handle"/>
									<field name="name"/>
									<field name="rest"/>
									<field name="start_hour" widget="float_time" invisible="rest"/>
									<field name="hours" widget="float_time" invisible="rest"/>
									<field name="role_id" invisible="rest"/>
								</list>
							</field>
						</page>
						<page string="People" name="people">
							<field name="member_ids">
								<list editable="bottom">
									<field name="employee_id"/>
									<field name="start_date"/>
									<field name="end_date"/>
									<field name="offset"/>
								</list>
							</field>
						</page>
					</notebook>
				</sheet>
			</form>
		</field>
	</record>
	<record id="action_rotation" model="ir.actions.act_window">
		<field name="name">Rotating Shifts</field>
		<field name="res_model">veron.planning.rotation</field>
		<field name="view_mode">list,form</field>
	</record>
	<menuitem id="menu_rotation" name="Rotating Shifts" parent="veron_planning.menu_config" action="action_rotation"/>
</odoo>
