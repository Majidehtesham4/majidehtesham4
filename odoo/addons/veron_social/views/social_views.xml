<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="post_view_form" model="ir.ui.view">
		<field name="name">veron.social.post.form</field>
		<field name="model">veron.social.post</field>
		<field name="arch" type="xml">
			<form>
				<header>
					<button name="action_post_now" type="object" string="Post Now" class="btn-primary" invisible="state in ('posted', 'scheduled')"/>
					<button name="action_schedule" type="object" string="Schedule" invisible="state != 'draft'"/>
					<button name="action_draft" type="object" string="Back to Draft" invisible="state != 'scheduled'"/>
					<field name="state" widget="statusbar" statusbar_visible="draft,scheduled,posted"/>
				</header>
				<sheet>
					<group>
						<group>
							<field name="account_ids" widget="many2many_tags" readonly="state == 'posted'"/>
							<field name="scheduled_date" readonly="state in ('posted', 'scheduled')"/>
							<field name="posted_date" invisible="not posted_date"/>
						</group>
						<group>
							<field name="image" widget="image" class="oe_avatar" readonly="state == 'posted'"/>
						</group>
					</group>
					<field name="message" placeholder="The text of the post..." readonly="state == 'posted'" class="o_veron_social_message"/>
					<field name="line_ids" invisible="not line_ids">
						<list>
							<field name="account_id"/>
							<field name="platform"/>
							<field name="state" widget="badge" decoration-success="state == 'posted'" decoration-danger="state == 'failed'"/>
							<field name="error"/>
						</list>
					</field>
				</sheet>
				<chatter/>
			</form>
		</field>
	</record>

	<record id="post_view_list" model="ir.ui.view">
		<field name="name">veron.social.post.list</field>
		<field name="model">veron.social.post</field>
		<field name="arch" type="xml">
			<list>
				<field name="name"/>
				<field name="account_ids" widget="many2many_tags"/>
				<field name="scheduled_date"/>
				<field name="posted_date"/>
				<field name="state" widget="badge" decoration-info="state == 'scheduled'" decoration-success="state == 'posted'" decoration-warning="state == 'partial'" decoration-danger="state == 'failed'"/>
			</list>
		</field>
	</record>

	<record id="post_view_calendar" model="ir.ui.view">
		<field name="name">veron.social.post.calendar</field>
		<field name="model">veron.social.post</field>
		<field name="arch" type="xml">
			<calendar date_start="scheduled_date" mode="month" color="state" quick_create="false">
				<field name="state"/>
			</calendar>
		</field>
	</record>

	<record id="account_view_list" model="ir.ui.view">
		<field name="name">veron.social.account.list</field>
		<field name="model">veron.social.account</field>
		<field name="arch" type="xml">
			<list>
				<field name="name"/>
				<field name="platform"/>
				<field name="chat_id"/>
			</list>
		</field>
	</record>

	<record id="account_view_form" model="ir.ui.view">
		<field name="name">veron.social.account.form</field>
		<field name="model">veron.social.account</field>
		<field name="arch" type="xml">
			<form>
				<header>
					<button name="action_test" type="object" string="Send a Test Message" class="btn-primary"/>
				</header>
				<sheet>
					<group>
						<field name="name"/>
						<field name="platform"/>
						<field name="chat_id"/>
						<field name="token" password="True" groups="base.group_system"/>
					</group>
					<div class="text-muted">
						Make the bot an administrator of the channel. Telegram works only from a server that reaches api.telegram.org.
					</div>
				</sheet>
			</form>
		</field>
	</record>

	<record id="action_posts" model="ir.actions.act_window">
		<field name="name">Posts</field>
		<field name="res_model">veron.social.post</field>
		<field name="view_mode">list,form,calendar</field>
		<field name="help" type="html">
			<p class="o_view_nocontent_smiling_face">Write the first post</p>
			<p>To Bale, Eitaa or Telegram channels, now or at a set time.</p>
		</field>
	</record>
	<record id="action_accounts" model="ir.actions.act_window">
		<field name="name">Channels</field>
		<field name="res_model">veron.social.account</field>
		<field name="view_mode">list,form</field>
	</record>

	<menuitem id="menu_root" name="Social Posting" web_icon="veron_social,static/description/icon.png" groups="group_social_user" sequence="57"/>
	<menuitem id="menu_posts" name="Posts" parent="menu_root" action="action_posts" sequence="1"/>
	<menuitem id="menu_accounts" name="Channels" parent="menu_root" action="action_accounts" sequence="2"/>
</odoo>
