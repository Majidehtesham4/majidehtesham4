msgstr "ردیف #{0}: باید یک دارایی برای کالا {1} انتخاب کنید."

msgid "Row #{0}: {1} account is not of type {2}"
msgstr "ردیف #{0}: حساب {1} از نوع {2} نیست"

msgid "Row #{0}: {1} is mandatory for the Inventory Dimension {2}."
msgstr "ردیف #{0}: {1} برای بُعد موجودی {2} الزامی است."

msgid "Row #{0}:Quantity for Item {1} cannot be zero."
msgstr "ردیف #{0}: مقدار برای کالا {1} نمی‌تواند صفر باشد."

msgid "Row #{idx}: Item rate has been updated as per valuation rate since its an internal stock transfer."
msgstr "ردیف #{idx}: نرخ کالا براساس نرخ ارزش‌گذاری به‌روزرسانی شده است، زیرا یک انتقال داخلی موجودی است."

msgid "Row #{idx}: Received Qty must be equal to Accepted + Rejected Qty for Item {item_code}."
msgstr "ردیف #{idx}: مقدار دریافتی باید برابر با تعداد پذیرفته شده + تعداد رد شده برای کالا {item_code} باشد."

msgid "Row #{}: POS Invoice {} has been {}"
msgstr "ردیف #{}: فاکتور صندوق فروش {} شده است {}"

