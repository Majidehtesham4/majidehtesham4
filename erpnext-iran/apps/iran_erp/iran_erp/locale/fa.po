msgstr "ردیف {0}: چون {1} فعال است، مواد اولیه را نمی‌توان به سند {2} اضافه کرد. برای مصرف مواد اولیه از سند {3} استفاده کنید."

msgid "Row {0}: Bill of Materials not found for the Item {1}"
msgstr "ردیف {0}: صورتحساب مواد برای کالا {1} یافت نشد"

msgid "Row {0}: Cannot sell item {1} from Sample Retention Warehouse {2}"
msgstr "ردیف {0}: فروش کالای {1} از انبار نگهداری نمونه {2} مجاز نیست"

msgid "Row {0}: Currency of the BOM #{1} should be equal to the selected currency {2}"
msgstr "ردیف {0}: واحد پول فهرست مواد #{1} باید برابر با ارز انتخابی {2} باشد."

msgid "Row {0}: Delivery Warehouse cannot be same as Customer Warehouse for Item {1}."
msgstr "ردیف {0}: انبار تحویل نمی‌تواند با انبار مشتری برای کالای {1} یکسان باشد."

msgid "Row {0}: Expected Value After Useful Life cannot be negative"
msgstr "ردیف {0}: ارزش مورد انتظار پس از عمر مفید نمی‌تواند منفی باشد"

msgid "Row {0}: Expected Value After Useful Life must be less than Net Purchase Amount"
msgstr "ردیف {0}: ارزش مورد انتظار پس از عمر مفید باید کمتر از مبلغ خالص خرید باشد"

msgid "Row {0}: Expense Account {1} is linked to company {2}. Please select an account belonging to company {3}."
msgstr "ردیف {0}: حساب هزینه {1} به شرکت {2} متصل است. لطفاً حسابی متعلق به شرکت {3} انتخاب کنید."

msgid "Row {0}: Item Tax template updated as per validity and rate applied"
msgstr "ردیف {0}: الگوی مالیات کالا بر اساس اعتبار و نرخ اعمال شده به روز شد"

msgid "Row {0}: Item {1} is not allowed for {2} {3}."
msgstr "ردیف {0}: کالای {1} برای {2} {3} مجاز نیست."

msgid "Row {0}: Item {1} must be a subcontracted item."
msgstr "ردیف {0}: کالا {1} باید یک کالا قرارداد فرعی شده باشد."

msgid "Row {0}: Item {1} must be linked to a {2}."
msgstr "ردیف {0}: کالای {1} باید به یک {2} متصل باشد."

msgid "Row {0}: Item {1}'s quantity cannot be higher than the available quantity."
msgstr "ردیف {0}: مقدار کالای {1} نمی‌تواند بیشتر از مقدار موجود باشد."

msgid "Row {0}: Operation time should be greater than 0 for operation {1}"
msgstr "ردیف {0}: زمان عملیات برای عملیات {1} باید بیشتر از ۰ باشد"

msgid "Row {0}: Please select a BOM for Item {1}."
msgstr "ردیف {0}: لطفاً یک فهرست مواد برای مورد {1} انتخاب کنید."

msgid "Row {0}: Please select an active BOM for Item {1}."
msgstr "ردیف {0}: لطفاً یک فهرست مواد فعال برای مورد {1} انتخاب کنید."

