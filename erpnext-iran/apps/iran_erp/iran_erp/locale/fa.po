#: iran_erp/public/js/jalali.js
msgid "Jalali"
msgstr "شمسی"

#: iran_erp/validations.py
msgid "National ID {0} is not valid"
msgstr "کد ملی / شناسه ملی {0} معتبر نیست"

#: iran_erp/validations.py
msgid "Economic Code {0} is not valid"
msgstr "کد اقتصادی {0} معتبر نیست"

#: iran_erp/install.py
msgid "10 digits for individuals, 11 digits for legal entities"
msgstr "۱۰ رقم برای اشخاص حقیقی، ۱۱ رقم برای اشخاص حقوقی"

# Translations missing from the upstream Frappe / ERPNext Persian catalogs, and upstream
# entries normalised to Persian terms (BOM, UOM, POS, «آیتم» -> «کالا»). iran_erp is installed
# after frappe and erpnext, so these entries take effect on top of theirs.

msgid " BOM"
msgstr " فهرست مواد"

msgid " Item"
msgstr " کالا"

msgid " Phantom Item"
msgstr " کالا فانتوم"

msgid "\"Customer Provided Item\" cannot be Purchase Item also"
msgstr "\"کالا تامین شده توسط مشتری\" نمی‌تواند کالا خرید هم باشد"

msgid "\"Customer Provided Item\" cannot have Valuation Rate"
msgstr "\"کالا تامین شده توسط مشتری\" نمی‌تواند دارای نرخ ارزش‌گذاری باشد"

msgid "# Req'd Items"
msgstr "# کالاهای درخواست شده"

msgid "% Complete must be between 0 and 100"
msgstr "درصد تکمیل باید بین ۰ تا ۱۰۰ باشد"

msgid "% Finished Item Quantity"
msgstr "% مقدار کالا تمام شده"

msgid "% of Component Cost"
msgstr "درصد از هزینه جزء"

msgid "'Verification Link Expiry Duration' must be between 15 to 60 minutes."
msgstr "«مدت اعتبار لینک تأیید» باید بین ۱۵ تا ۶۰ دقیقه باشد."

msgid "'{0}' is a reserved name and cannot be used as a line reference"
msgstr "'{0}' یک نام رزروشده است و نمی‌تواند به‌عنوان مرجع ردیف استفاده شود"

msgid "(Daily Yield * No of Units Produced) / 100"
msgstr "(بازده روزانه × تعداد واحدهای تولیدشده) / ۱۰۰"

msgid "+ Add Price"
msgstr "+ افزودن قیمت"

msgid "<b>Cannot create asset.</b><br><br>You're trying to create <b>{0} asset(s)</b> from {2} {3}.<br>However, only <b>{1} item(s)</b> were purchased and <b>{4} asset(s)</b> already exist against {5}."
msgstr "<b>امکان ایجاد دارایی وجود ندارد.</b><br><br>شما در حال ایجاد <b>{0} دارایی</b> از {2} {3} هستید.<br>اما فقط <b>{1} قلم</b> خریداری شده و <b>{4} دارایی</b> از قبل برای {5} وجود دارد."

msgid "<b>Row #{0}:</b> Bundle {1} in warehouse {2} has insufficient packed items:<br><div style='margin-top: 15px;'><ul style='line-height: 0.8;'>{3}</ul></div>"
msgstr "<b>ردیف #{0}:</b> بسته {1} در انبار {2} اقلام بسته‌بندی کافی ندارد:<br><div style='margin-top: 15px;'><ul style='line-height: 0.8;'>{3}</ul></div>"

msgid "<div style=\"margin-bottom:10px; color: var(--gray-500) !important;\">Define alternate units for this item. Eg: 1 Box = 12 Nos, set conversion factor as 12. (Will also apply for variants) <a href=\"https://docs.frappe.io/erpnext/uom\" target=\"_blank\">Learn more &#8594;</a></div>"
msgstr "<div style=\"margin-bottom:10px; color: var(--gray-500) !important;\">واحدهای جایگزین این کالا را تعریف کنید. مثلاً: ۱ جعبه = ۱۲ عدد، ضریب تبدیل را ۱۲ قرار دهید. (برای گونه‌ها هم اعمال می‌شود) <a href=\"https://docs.frappe.io/erpnext/uom\" target=\"_blank\">بیشتر بدانید &#8592;</a></div>"

msgid "<li>Packed Item {0}: Required {1}, Available {2}</li>"
msgstr "<li>کالای بسته‌بندی‌شده {0}: مورد نیاز {1}، موجود {2}</li>"

msgid "<li>Payment document required for row(s): {0}</li>"
msgstr "<li>سند پرداخت برای ردیف(های) {0} الزامی است</li>"

msgid "<p>Cannot overbill for the following Items:</p>"
msgstr "<p>صدور فاکتور بیش از مقدار برای اقلام زیر امکان‌پذیر نیست:</p>"

msgid "<p>To allow over-billing, please set allowance in Accounts Settings.</p>"
msgstr "<p>برای اجازه صدور فاکتور بیش از مقدار، در تنظیمات حساب‌ها مقدار مجاز را تعیین کنید.</p>"

msgid "<span class=\"h4\"><b>Subcontracting Inward and Outward</b></span>"
msgstr "<span class=\"h4\"><b>ورود و خروج پیمانکاری فرعی</b></span>"

msgid "<strong>Total qty</strong> of the rows (<strong>{0}</strong>) does not match the <strong>Qty to Fetch</strong> (<strong>{1}</strong>). Qty of the item will be changed to <strong>{0}</strong>. Are you sure want to proceed?"
msgstr "<strong>مقدار کل</strong> ردیف‌ها (<strong>{0}</strong>) با <strong>مقدار برای دریافت</strong> (<strong>{1}</strong>) برابر نیست. مقدار کالا به <strong>{0}</strong> تغییر می‌کند. آیا مطمئن هستید که می‌خواهید ادامه دهید؟"

msgid "A Period Closing Voucher is already submitted and an Opening Entry can no longer be created. {0} to learn more."
msgstr "سند بستن دوره قبلاً ثبت شده است و دیگر نمی‌توان سند افتتاحیه ایجاد کرد. برای اطلاعات بیشتر {0}."

msgid "A Price List is a collection of Item Prices either Selling, Buying, or both"
msgstr "لیست قیمت مجموعه ای از قیمت های کالاهای فروش، خرید یا هر دو است"

msgid "A band of scores, and what happens to suppliers in it."
msgstr "یک بازه امتیاز و اتفاقی که برای تأمین‌کنندگان آن بازه می‌افتد."

msgid "A bank account of yours or of a customer or supplier."
msgstr "حساب بانکی شما یا یک مشتری یا تأمین‌کننده."

msgid "A bank you or your customers and suppliers hold accounts with."
msgstr "بانکی که شما یا مشتریان و تأمین‌کنندگانتان در آن حساب دارید."

msgid "A batch of payments to send to your bank."
msgstr "دسته‌ای از پرداخت‌ها برای ارسال به بانک."

msgid "A bill from a supplier for what you bought."
msgstr "صورت‌حساب تأمین‌کننده برای آنچه خریده‌اید."

msgid "A bill to a customer for what you sold."
msgstr "صورت‌حساب به مشتری برای آنچه فروخته‌اید."

msgid "A branch of your company."
msgstr "شعبه‌ای از شرکت شما."

msgid "A brand your items are sold under."
msgstr "برندی که کالاهای شما با آن فروخته می‌شوند."

msgid "A business or person you buy from. See [Supplier](https://docs.frappe.io/erpnext/user/manual/en/supplier)."
msgstr "کسب‌وکار یا شخصی که از او خرید می‌کنید. ببینید: [تأمین‌کننده](https://docs.frappe.io/erpnext/user/manual/en/supplier)."

msgid "A business or person you sell to. See [Customer](https://docs.frappe.io/erpnext/user/manual/en/customer)."
msgstr "کسب‌وکار یا شخصی که به او می‌فروشید. ببینید: [مشتری](https://docs.frappe.io/erpnext/user/manual/en/customer)."

msgid "A certificate that lets you withhold less tax from a supplier."
msgstr "گواهی‌ای که اجازه می‌دهد مالیات تکلیفی کمتری از تأمین‌کننده کسر کنید."

msgid "A channel customers reach you on, like a phone line."
msgstr "کانالی که مشتریان از طریق آن با شما تماس می‌گیرند، مانند خط تلفن."

msgid "A class of shares, like equity or preference."
msgstr "نوعی سهم، مانند عادی یا ممتاز."

msgid "A code customers enter to get a discount from a pricing rule."
msgstr "کدی که مشتریان برای گرفتن تخفیف از یک قانون قیمت‌گذاری وارد می‌کنند."

msgid "A code from a code list and what it maps to."
msgstr "یک کد از فهرست کدها و آنچه به آن نگاشت می‌شود."

msgid "A company or person you buy goods or services from."
msgstr "شرکت یا شخصی که از او کالا یا خدمات می‌خرید."

msgid "A company or person you sell goods or services to."
msgstr "شرکت یا شخصی که به او کالا یا خدمات می‌فروشید."

msgid "A company that makes the items you buy or sell."
msgstr "شرکتی که کالاهای مورد خرید یا فروش شما را تولید می‌کند."

msgid "A company you are trying to win as a customer, with its leads."
msgstr "شرکتی که می‌خواهید مشتری شما شود، همراه با سرنخ‌های آن."

msgid "A customer's claim to repair or replace an item under warranty."
msgstr "درخواست مشتری برای تعمیر یا تعویض کالا تحت گارانتی."

msgid "A customer's confirmed order."
msgstr "سفارش تأییدشده مشتری."

msgid "A date range you can close so no one posts into it."
msgstr "بازه زمانی که می‌توانید ببندید تا کسی در آن سند ثبت نکند."

msgid "A department of your company."
msgstr "واحدی از شرکت شما."

msgid "A direct entry in your books, for anything without its own form."
msgstr "ثبت مستقیم در دفاتر، برای هر چیزی که فرم مخصوص ندارد."

msgid "A disabled Product Bundle cannot be selected in transactions."
msgstr "بسته محصول غیرفعال را نمی‌توان در تراکنش‌ها انتخاب کرد."

msgid "A distributor, dealer or reseller who sells for you on commission."
msgstr "توزیع‌کننده، نماینده یا فروشنده‌ای که با کمیسیون برای شما می‌فروشد."

msgid "A draft reverse journal for {0} has been created: {1}"
msgstr "یک سند برگشتی پیش‌نویس برای {0} ایجاد شد: {1}"

msgid "A few quick questions so we can set things up the way you work."
msgstr "چند سؤال کوتاه تا سیستم را مطابق روش کار شما تنظیم کنیم."

msgid "A finer grouping of bank accounts, like savings or current."
msgstr "گروه‌بندی جزئی‌تر حساب‌های بانکی، مانند پس‌انداز یا جاری."

msgid "A folder cannot have a File URL"
msgstr "پوشه نمی‌تواند نشانی فایل داشته باشد"

msgid "A group of tax withholding categories that apply together."
msgstr "گروهی از دسته‌های مالیات تکلیفی که با هم اعمال می‌شوند."

msgid "A group of units of an item made or received together."
msgstr "گروهی از واحدهای یک کالا که با هم تولید یا دریافت شده‌اند."

msgid "A grouping of bank accounts, like checking or credit card."
msgstr "گروه‌بندی حساب‌های بانکی، مانند جاری یا کارت اعتباری."

msgid "A grouping of calls, like sales or support."
msgstr "گروه‌بندی تماس‌ها، مانند فروش یا پشتیبانی."

msgid "A grouping of inspection parameters."
msgstr "گروه‌بندی پارامترهای بازرسی."

msgid "A grouping of issues, like billing or technical."
msgstr "گروه‌بندی مسائل، مانند صورت‌حساب یا فنی."

msgid "A grouping of projects, like internal or external."
msgstr "گروه‌بندی پروژه‌ها، مانند داخلی یا خارجی."

msgid "A grouping of tasks, like bug or feature."
msgstr "گروه‌بندی وظایف، مانند اشکال یا ویژگی."

msgid "A grouping of units, like weight or length."
msgstr "گروه‌بندی واحدها، مانند وزن یا طول."

msgid "A grouping of warehouses, like transit or store."
msgstr "گروه‌بندی انبارها، مانند در راه یا فروشگاه."

msgid "A guarantee a bank gives on your behalf, or on a customer's or supplier's."
msgstr "ضمانت‌نامه‌ای که بانک از طرف شما یا مشتری یا تأمین‌کننده صادر می‌کند."

msgid "A job title, like manager or accountant."
msgstr "عنوان شغلی، مانند مدیر یا حسابدار."

msgid "A kind of stock entry, like material transfer or manufacture."
msgstr "نوعی ورود کالا، مانند انتقال مواد یا تولید."

msgid "A kind of work you track time against, like design or support."
msgstr "نوعی کار که زمان آن را پیگیری می‌کنید، مانند طراحی یا پشتیبانی."

msgid "A kind of workstation, with its costs."
msgstr "نوعی ایستگاه کاری، همراه با هزینه‌های آن."

msgid "A ledger in your chart of accounts that entries are posted to."
msgstr "حسابی در نمودار حساب‌ها که اسناد در آن ثبت می‌شوند."

msgid "A legal entity with its own books, like your business or a subsidiary."
msgstr "شخص حقوقی با دفاتر مستقل، مانند کسب‌وکار شما یا یک شرکت تابعه."

msgid "A line from your bank statement, ready to be matched with a payment."
msgstr "ردیفی از صورت‌حساب بانک که آماده تطبیق با یک پرداخت است."

msgid "A machine or place where operations are done."
msgstr "ماشین یا مکانی که عملیات در آن انجام می‌شود."

msgid "A marketing campaign, to see which leads and sales it brought in."
msgstr "کمپین بازاریابی، برای دیدن اینکه چه سرنخ‌ها و فروش‌هایی آورده است."

msgid "A meeting booked with a lead or customer."
msgstr "قرار ملاقات با یک سرنخ یا مشتری."

msgid "A meeting to review quality, with its agenda and minutes."
msgstr "جلسه بازبینی کیفیت، همراه با دستور جلسه و صورت‌جلسه."

msgid "A naming series conflict occurred while creating serial numbers. Please change the naming series for the item {0}."
msgstr "هنگام ایجاد شماره سریال‌ها تداخل در سری نام‌گذاری رخ داد. لطفاً سری نام‌گذاری کالای {0} را تغییر دهید."

msgid "A parcel size you ship often."
msgstr "اندازه بسته‌ای که اغلب ارسال می‌کنید."

msgid "A parcel you send through a carrier."
msgstr "بسته‌ای که از طریق شرکت حمل ارسال می‌کنید."

msgid "A part of your business you track income and expenses for, like a branch or product line."
msgstr "بخشی از کسب‌وکار که درآمد و هزینه آن را پیگیری می‌کنید، مانند یک شعبه یا خط محصول."

msgid "A periodic check of how a quality goal is going."
msgstr "بررسی دوره‌ای روند یک هدف کیفیت."

msgid "A person or company that owns shares in your company."
msgstr "شخص یا شرکتی که سهامدار شرکت شماست."

msgid "A person you deal with, at a customer, supplier or anywhere else."
msgstr "شخصی که با او در ارتباط هستید، در یک مشتری، تأمین‌کننده یا هر جای دیگر."

msgid "A phone call made or received."
msgstr "تماس تلفنی گرفته‌شده یا دریافت‌شده."

msgid "A piece of work to be done, often part of a project."
msgstr "کاری که باید انجام شود، اغلب بخشی از یک پروژه."

msgid "A piece of work with tasks, time and costs."
msgstr "کاری با وظایف، زمان و هزینه."

msgid "A place where you keep stock."
msgstr "مکانی که کالا را در آن نگه می‌دارید."

msgid "A place where your assets are kept."
msgstr "مکانی که دارایی‌های شما در آن نگهداری می‌شوند."

msgid "A postal address of a customer, supplier, company or contact."
msgstr "نشانی پستی یک مشتری، تأمین‌کننده، شرکت یا مخاطب."

msgid "A potential sale to a lead or customer."
msgstr "یک فروش احتمالی به یک سرنخ یا مشتری."

msgid "A problem or question raised by a customer."
msgstr "مشکل یا پرسشی که مشتری مطرح کرده است."

msgid "A product or a service you sell. See [Item](https://docs.frappe.io/erpnext/user/manual/en/item)."
msgstr "کالا یا خدمتی که می‌فروشید. ببینید: [کالا](https://docs.frappe.io/erpnext/user/manual/en/item)."

msgid "A product or service you buy, sell or keep in stock."
msgstr "کالا یا خدمتی که می‌خرید، می‌فروشید یا در انبار نگه می‌دارید."

msgid "A progress update collected from the project team."
msgstr "گزارش پیشرفتی که از تیم پروژه جمع‌آوری شده است."

msgid "A property item variants differ by, like size or colour."
msgstr "ویژگی‌ای که گونه‌های کالا با آن متفاوت می‌شوند، مانند اندازه یا رنگ."

msgid "A published list of codes, like units or tax categories, used in e-invoicing."
msgstr "فهرست منتشرشده‌ای از کدها، مانند واحدها یا دسته‌های مالیاتی، که در صورتحساب الکترونیکی استفاده می‌شود."

msgid "A quality inspection must be completed before generating a Delivery Note for this item."
msgstr "پیش از صدور حواله تحویل برای این کالا باید بازرسی کیفیت انجام شود."

msgid "A quality inspection must be completed before generating a Purchase Receipt for this item."
msgstr "پیش از صدور رسید خرید برای این کالا باید بازرسی کیفیت انجام شود."

msgid "A record of maintenance done on an asset."
msgstr "سابقه نگهداری انجام‌شده روی یک دارایی."

msgid "A record of shares issued, bought back or moved between shareholders."
msgstr "سابقه سهام صادرشده، بازخریدشده یا منتقل‌شده بین سهامداران."

msgid "A region you sell in, to group customers and set targets."
msgstr "منطقه‌ای که در آن می‌فروشید، برای گروه‌بندی مشتریان و تعیین هدف."

msgid "A regular email summing up how the business is doing."
msgstr "ایمیل منظمی که وضعیت کسب‌وکار را خلاصه می‌کند."

msgid "A reminder to a customer about an overdue invoice."
msgstr "یادآوری به مشتری درباره فاکتور سررسیدگذشته."

msgid "A repair made to an asset, and what it cost."
msgstr "تعمیری که روی یک دارایی انجام شده و هزینه آن."

msgid "A request to buy, transfer or make items."
msgstr "درخواست خرید، انتقال یا تولید کالا."

msgid "A sale made at the point of sale."
msgstr "فروشی که در صندوق فروشگاه انجام شده است."

msgid "A saved set of accounts to start journal entries from."
msgstr "مجموعه‌ای ذخیره‌شده از حساب‌ها برای شروع اسناد حسابداری."

msgid "A separate Purchase Order is created for each Supplier."
msgstr "برای هر تأمین‌کننده یک سفارش خرید جداگانه ایجاد می‌شود."

msgid "A separate set of books, for example to depreciate assets under another rule."
msgstr "مجموعه دفاتر جداگانه، مثلاً برای استهلاک دارایی‌ها با قاعده‌ای دیگر."

msgid "A series of emails sent to leads or contacts on a schedule."
msgstr "مجموعه‌ای از ایمیل‌ها که طبق برنامه برای سرنخ‌ها یا مخاطبان ارسال می‌شود."

msgid "A set of discounts and free items, like buy two get one free."
msgstr "مجموعه‌ای از تخفیف‌ها و کالاهای رایگان، مانند دو بخر یکی ببر."

msgid "A set of item prices for buying, selling or both."
msgstr "مجموعه‌ای از قیمت کالاها برای خرید، فروش یا هر دو."

msgid "A set of payment terms to apply to invoices and orders."
msgstr "مجموعه‌ای از شرایط پرداخت برای اعمال روی فاکتورها و سفارش‌ها."

msgid "A set of tasks to start new projects from."
msgstr "مجموعه‌ای از وظایف برای شروع پروژه‌های جدید."

msgid "A single unit of an item, tracked by its own number."
msgstr "یک واحد از کالا که با شماره مخصوص خودش پیگیری می‌شود."

msgid "A step in making an item, like cutting or assembly."
msgstr "مرحله‌ای از ساخت کالا، مانند برش یا مونتاژ."

msgid "A step in your sales process, like qualification or negotiation."
msgstr "مرحله‌ای از فرایند فروش، مانند ارزیابی یا مذاکره."

msgid "A unit you measure items in, like kg or box."
msgstr "واحدی که کالاها را با آن اندازه می‌گیرید، مانند کیلوگرم یا جعبه."

msgid "A value a scorecard criterion is calculated from."
msgstr "مقداری که معیار کارت امتیاز از آن محاسبه می‌شود."

msgid "A vehicle's route to deliver to several customers."
msgstr "مسیر یک خودرو برای تحویل به چند مشتری."

msgid "A verified appointment cannot be moved back to 'Unverified' status."
msgstr "قرار ملاقات تأییدشده را نمی‌توان به وضعیت «تأییدنشده» برگرداند."

msgid "A view of your workstations and what each is doing."
msgstr "نمایی از ایستگاه‌های کاری و کاری که هر کدام انجام می‌دهد."

msgid "A visit to service or repair what a customer bought."
