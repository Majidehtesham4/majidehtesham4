msgstr "ردیف #{}: فاکتور صندوق فروش {} هنوز ثبت نهایی نشده است"

msgid "Row #{}: Party ID is required"
msgstr "ردیف #{}: شناسه طرف حساب الزامی است"

msgid "Row #{}: The original Invoice {} of return invoice {} is not consolidated."
msgstr "ردیف #{}: فاکتور اصلی {} مربوط به فاکتور مرجوعی {} تجمیع نشده است."

msgid "Row {0} in {1} {2}: Work Order quantity after process loss {3} exceeds the remaining allowed quantity {4}."
msgstr "ردیف {0} در {1} {2}: مقدار دستور کار پس از ضایعات فرایند {3} از مقدار مجاز باقی‌مانده {4} بیشتر است."

msgid "Row {0} is not a raw material serial / batch entry of {1}"
