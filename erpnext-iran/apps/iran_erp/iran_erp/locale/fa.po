msgid "Row #{0}: For Customer Provided Item {1}, Source Warehouse must be {2}"
msgstr "ردیف #{0}: برای کالای تأمین‌شده توسط مشتری {1}، انبار مبدأ باید {2} باشد"

msgid "Row #{0}: Frequency of Depreciation must be greater than zero"
msgstr "ردیف #{0}: دوره تناوب استهلاک باید بیشتر از صفر باشد"

msgid "Row #{0}: Item {1} cannot be transferred more than {2} against {3} {4}"
msgstr "ردیف #{0}: کالای {1} را نمی‌توان بیش از {2} در برابر {3} {4} منتقل کرد"

msgid "Row #{0}: Item {1} has no stock in warehouse {2}."
msgstr "ردیف #{0}: کالای {1} در انبار {2} موجودی ندارد."

msgid "Row #{0}: Item {1} has zero rate but '{2}' is not enabled."
msgstr "ردیف #{0}: نرخ کالای {1} صفر است اما '{2}' فعال نیست."

