# Copy to .env and change both passwords before the first start.
ADMIN_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too
HTTP_PORT=8080
# The showroom's website (automodiran): started with the system when this line is here; its port;
# its branch on GitHub; and which business environment it shows (localhost: the main site)
COMPOSE_PROFILES=website
WEBSITE_PORT=80
WEBSITE_REF=main
WEBSITE_ERP_HOST=localhost
